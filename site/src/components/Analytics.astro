---
/**
 * Google Analytics 4 (gtag.js).
 *
 * The tag is injected at runtime rather than emitted as a plain <script src>
 * so that it only ever loads on the production hostname. Without that guard,
 * local dev and every Vercel preview deploy report into the same GA property
 * and quietly inflate the real numbers.
 */
import { SITE_URL } from '@/lib/seo';

const GA_MEASUREMENT_ID = 'G-10FFVJJZB1';
const PROD_HOST = new URL(SITE_URL).hostname;
---

<script is:inline define:vars={{ GA_MEASUREMENT_ID, PROD_HOST }}>
  if (location.hostname === PROD_HOST || location.hostname === `www.${PROD_HOST}`) {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', GA_MEASUREMENT_ID);

    const tag = document.createElement('script');
    tag.async = true;
    tag.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(tag);
  }
</script>
