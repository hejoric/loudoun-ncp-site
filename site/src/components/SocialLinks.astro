---
import { getSocialLinks } from '@/lib/social';

interface Props {
  /** 'icon' renders icons only; 'labeled' renders icon + platform name. */
  variant?: 'icon' | 'labeled';
  class?: string;
}

const { variant = 'icon', class: className = '' } = Astro.props;

const links = await getSocialLinks();

const iconSize = variant === 'icon' ? 'w-5 h-5' : 'w-4 h-4';
const linkClass =
  variant === 'icon'
    ? 'text-ink-soft hover:text-ink transition-colors'
    : 'text-ink-soft hover:text-ink transition-colors flex items-center gap-2 text-sm font-medium';
// Labeled links stack so the list stays readable in a narrow card and scales
// as profiles are added; icon-only links sit on one row.
const listClass =
  variant === 'icon'
    ? 'flex flex-wrap items-center gap-x-4 gap-y-2'
    : 'flex flex-col items-start gap-2';
---

{
  links.length > 0 && (
    <div class:list={[listClass, className]}>
      {links.map((link) => (
        <a
          href={link.href}
          class={linkClass}
          aria-label={variant === 'icon' ? link.label : undefined}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class={iconSize} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d={link.path} fill-rule={link.fillRule} clip-rule={link.fillRule} />
          </svg>
          {variant === 'labeled' && link.label}
        </a>
      ))}
    </div>
  )
}
