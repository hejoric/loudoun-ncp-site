---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/lncp-logo.png';
import { responsive } from '@/lib/images';

// Read down each column: About / Research, Team / Events, Press / Contact.
// Home is the logo.
const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/research/', label: 'Research' },
  { href: '/team/', label: 'Team' },
  { href: '/events/', label: 'Events' },
  { href: '/press/', label: 'Press' },
  { href: '/contact/', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href);
---

<!-- Floats over each page's hero. On a photo hero it sits straight on the photo
     in white type with a soft shadow (no paper wash); on a plain paper hero it
     keeps ink type. From lg up it is fixed and takes a frosted paper ground
     with ink type once the content sheet reaches it (on a plain hero, once the
     page scrolls); on smaller screens it scrolls away with the hero, so it
     never costs a phone a permanent strip of the viewport and stays
     transparent with light type until it leaves. Every link stays visible at
     every width - there is no hamburger to hide Volunteer behind. -->
<header class="site-nav absolute lg:fixed inset-x-0 top-0 z-50" data-site-nav>
  <nav
    class="grid grid-cols-[1fr_auto] lg:grid-cols-[1fr_auto_1fr] items-center gap-x-6 gap-y-4 px-(--gutter) pt-4 pb-3 lg:py-4"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center gap-3 shrink-0 nav-brand" aria-label="Loudoun Nature Conservation Project home">
      <Image
        src={logo}
        alt=""
        {...responsive(logo, [36, 40, 72, 80, 108, 120], '(min-width: 640px) 40px, 36px')}
        class="w-9 h-9 sm:w-10 sm:h-10 object-contain shrink-0"
        loading="eager"
      />
      <span class="font-body font-medium text-sm sm:text-[0.9375rem] leading-[1.15] tracking-[-0.01em]">
        Loudoun Nature<br />Conservation Project
      </span>
    </a>

    <ul class="nav-cluster col-span-2 row-start-2 lg:col-span-1 lg:row-start-1 lg:col-start-2" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))}
    </ul>

    <a href="/volunteer/" class="btn btn-action justify-self-end" aria-current={isActive('/volunteer/') ? 'page' : undefined}>
      Volunteer
    </a>
  </nav>
</header>

<style>
  /* Type colour for the wordmark, links and bullets. Ink by default; white
     over a photo hero (found with :has, so no page has to say so). There the
     ground and the type switch in the same frame, with no fade, so white type
     never shows on paper and ink never shows on the photo. */
  .site-nav {
    --nav-fg: var(--color-ink);
    --nav-shadow: none;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  :global(body:has(.hero-media)) .site-nav {
    --nav-fg: var(--color-paper);
    --nav-shadow: 0 1px 12px rgb(15 22 17 / 0.5), 0 0 2px rgb(15 22 17 / 0.35);
    transition: none;
  }
  /* The site's forest focus ring would vanish on the photo; it stays light
     whenever the type is light (stuck only counts from lg up). */
  :global(body:has(.hero-media)) .site-nav:not([data-stuck]) :focus-visible {
    outline-color: var(--color-paper);
  }
  @media (max-width: 1023px) {
    :global(body:has(.hero-media)) .site-nav :focus-visible {
      outline-color: var(--color-paper);
    }
  }
  /* Only from lg up is the nav fixed, so only there does it take the frosted
     ground (and return to ink). Below lg it scrolls off with the hero. */
  @media (min-width: 1024px) {
    .site-nav[data-stuck] {
      background: rgb(245 244 239 / 0.88);
      -webkit-backdrop-filter: saturate(1.4) blur(14px);
      backdrop-filter: saturate(1.4) blur(14px);
      box-shadow: 0 1px 0 var(--hairline);
    }
    :global(body:has(.hero-media)) .site-nav[data-stuck] {
      --nav-fg: var(--color-ink);
      --nav-shadow: none;
    }
  }
  .nav-brand {
    color: var(--nav-fg);
    text-shadow: var(--nav-shadow);
  }

  /* GCC's bulleted link cluster: three short columns, read top to bottom. */
  .nav-cluster {
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    justify-content: start;
    column-gap: clamp(1.75rem, 4vw, 3.5rem);
    row-gap: 0.5rem;
  }
  .nav-cluster a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.125rem;
    font: 500 0.875rem/1.2 var(--font-body);
    color: var(--nav-fg);
    text-shadow: var(--nav-shadow);
    transition: transform 0.2s var(--ease-out);
  }
  .nav-cluster a::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .nav-cluster a[aria-current='page']::before {
    background: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-cluster a:hover {
      transform: translateX(4px);
    }
  }
  /* On a phone the three columns share the width evenly under the logo row. */
  @media (max-width: 1023px) {
    .nav-cluster {
      grid-template-columns: repeat(3, minmax(0, auto));
    }
  }
</style>

<script>
  // Over a photo hero the nav is stuck once the content sheet's top edge
  // reaches its bottom edge, so the photo never gets a paper bar; the sheet is
  // measured, not the hero, because the home hero is pinned while the sheet
  // slides over it. Every other page is stuck after a short scroll.
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  if (nav) {
    const sheet = document.querySelector('.hero-media') && document.querySelector('.sheet');
    const sync = () =>
      nav.toggleAttribute(
        'data-stuck',
        sheet ? sheet.getBoundingClientRect().top <= nav.getBoundingClientRect().bottom : window.scrollY > 24,
      );
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
