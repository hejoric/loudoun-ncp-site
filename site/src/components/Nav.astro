---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/lncp-logo.png';
import { responsive } from '@/lib/images';

// Read down each column: About / Research, Team / Events, Press / Contact.
// Home is the logo.
const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/research/', label: 'Research' },
  { href: '/team/', label: 'Team' },
  { href: '/events/', label: 'Events' },
  { href: '/press/', label: 'Press' },
  { href: '/contact/', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href);
---

<!-- Floats over each page's hero, on the paper fade at the hero's top edge.
     From lg up it is fixed and takes a frosted paper ground once the page
     scrolls; on smaller screens it scrolls away with the hero, so it never
     costs a phone a permanent strip of the viewport. Every link stays visible
     at every width - there is no hamburger to hide Volunteer behind. -->
<header class="site-nav absolute lg:fixed inset-x-0 top-0 z-50" data-site-nav>
  <nav
    class="grid grid-cols-[1fr_auto] lg:grid-cols-[1fr_auto_1fr] items-center gap-x-6 gap-y-4 px-(--gutter) pt-4 pb-3 lg:py-4"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center gap-3 shrink-0 text-ink" aria-label="Loudoun Nature Conservation Project home">
      <Image
        src={logo}
        alt=""
        {...responsive(logo, [36, 40, 72, 80, 108, 120], '(min-width: 640px) 40px, 36px')}
        class="w-9 h-9 sm:w-10 sm:h-10 object-contain shrink-0"
        loading="eager"
      />
      <span class="font-body font-medium text-sm sm:text-[0.9375rem] leading-[1.15] tracking-[-0.01em]">
        Loudoun Nature<br />Conservation Project
      </span>
    </a>

    <ul class="nav-cluster col-span-2 row-start-2 lg:col-span-1 lg:row-start-1 lg:col-start-2" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))}
    </ul>

    <a href="/volunteer/" class="btn btn-action justify-self-end" aria-current={isActive('/volunteer/') ? 'page' : undefined}>
      Volunteer
    </a>
  </nav>
</header>

<style>
  .site-nav {
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .site-nav[data-stuck] {
    background: rgb(245 244 239 / 0.88);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--hairline);
  }

  /* GCC's bulleted link cluster: three short columns, read top to bottom. */
  .nav-cluster {
    display: grid;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    justify-content: start;
    column-gap: clamp(1.75rem, 4vw, 3.5rem);
    row-gap: 0.5rem;
  }
  .nav-cluster a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.125rem;
    font: 500 0.875rem/1.2 var(--font-body);
    color: var(--color-ink);
    transition: transform 0.2s var(--ease-out);
  }
  .nav-cluster a::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .nav-cluster a[aria-current='page']::before {
    background: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-cluster a:hover {
      transform: translateX(4px);
    }
  }
  /* On a phone the three columns share the width evenly under the logo row. */
  @media (max-width: 1023px) {
    .nav-cluster {
      grid-template-columns: repeat(3, minmax(0, auto));
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  if (nav) {
    const sync = () => nav.toggleAttribute('data-stuck', window.scrollY > 24);
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
