---
import InitialsAvatar from './InitialsAvatar.astro';
import AffiliationBadges from './AffiliationBadges.astro';
import AffiliationNames from './AffiliationNames.astro';
import { affiliationLabel, type Affiliation } from '@/lib/affiliations';

interface Props {
  name: string;
  role: string;
  bio: string;
  headshot?: string | null;
  headshotPosition?: string | null;
  headshotScale?: string | null;
  email?: string | null;
  instagram?: string | null;
  linkedin?: string | null;
  website?: string | null;
  affiliations?: readonly Affiliation[];
  accentColor?: string;
  avatarSize?: string;
  /** Turn the card on hover. Off for cards on a moving strip, where hover means
   *  "pause" and the flip belongs to an explicit click/tap. */
  hoverFlip?: boolean;
  /** False for the duplicate cards a looping strip renders: they stay clickable
   *  but drop out of the tab order, since they are aria-hidden. */
  focusable?: boolean;
}

const {
  name,
  role,
  bio,
  headshot,
  headshotPosition,
  headshotScale,
  email,
  instagram,
  linkedin,
  website,
  affiliations = [],
  accentColor = '#1B4332',
  avatarSize = 'w-10 h-10',
  hoverFlip = true,
  focusable = true,
} = Astro.props;

// Every card for the same person shares this key so duplicates (the home strip
// renders the roster twice to loop seamlessly) turn together.
const flipKey = name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const focalPoint = headshotPosition || 'top';
const scale = Number(headshotScale) || 1;
const schools = affiliationLabel(affiliations);
// Links on the back of a duplicate card must not be tab stops either.
const linkTabIndex = focusable ? undefined : -1;
---

<div
  class:list={['card-flip w-full h-80 cursor-pointer', { 'card-flip-no-hover': !hoverFlip }]}
  tabindex={focusable ? 0 : -1}
  role="button"
  aria-label={`View ${name}'s profile`}
  aria-pressed="false"
  data-card-flip
  data-flip-key={flipKey}
>
  <div class="card-flip-inner">
    <!-- Front -->
    <div class="card-flip-front flex flex-col bg-paper border hairline">
      <!-- Headshot -->
      <div class="flex-1 relative overflow-hidden bg-gray-100">
        {headshot ? (
          <img
            src={headshot}
            alt={`${name} headshot`}
            class="absolute inset-0 w-full h-full object-cover"
            style={`object-position:${focalPoint};${scale !== 1 ? ` transform:scale(${scale}); transform-origin:center bottom;` : ''}`}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center">
            <InitialsAvatar name={name} size="xl" bgColor={accentColor} />
          </div>
        )}

        <!-- School / college logo badges (bottom-right) -->
        <AffiliationBadges affiliations={affiliations} />
      </div>
      {/* Name + role. The band keeps a constant height so the photo/band seam
          lands at the same place on every card in a row: the headshot above is
          flex-1, so a card with two school lines would otherwise push its seam
          ~30px higher than a card with none. 5.75rem is the tallest band in
          today's rows (name + one-line role + two school lines) plus a hair, and
          it also absorbs a role that wraps to two lines. Content is centered
          rather than top-aligned so a card with no school lines reads as a
          roomier band instead of an empty gap under the role. A third school
          line (the cap) grows the band instead of being clipped - reserving for
          it would cost every card 11px of headshot for a case no member has. */}
      <div
        class="p-3 text-center flex flex-col justify-center min-h-[5.75rem]"
        style={`background:${accentColor};`}
      >
        <p class="font-display font-bold text-white text-sm leading-tight">{name}</p>
        <p class="text-white/80 text-xs mt-0.5">{role}</p>
        <AffiliationNames affiliations={affiliations} />
      </div>
    </div>

    <!-- Back -->
    <div
      class="card-flip-back flex flex-col p-4 bg-paper border hairline"
    >
      <!-- Header band + small avatar -->
      <div class="flex items-center gap-2 pb-3 border-b border-gray-100" style={`border-color:${accentColor}33;`}>
        <div class={`${avatarSize} rounded-full overflow-hidden shrink-0`} style={`background:${accentColor};`}>
          {headshot ? (
            <img
              src={headshot}
              alt=""
              class="w-full h-full object-cover"
              style={`object-position:${headshotPosition || 'top'};`}
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          ) : (
            <InitialsAvatar name={name} size="sm" bgColor={accentColor} />
          )}
        </div>
        <div>
          <p class="font-display font-bold text-[#1c2b22] text-xs leading-tight">{name}</p>
          <p class="text-gray-600 text-xs">{role}</p>
        </div>
      </div>

      <!-- Bio -->
      <!-- tabindex is set for the same reason the links below carry it. This
           paragraph scrolls when the bio overflows, and Chromium adds a
           scrollable element to the tab order on its own, with no tabindex
           attribute involved - so dropping the duplicate copy's links out of
           the sequence is not enough on its own. Without this, tabbing through
           the home strip lands on seven bios inside the aria-hidden copy. -->
      <p class="text-xs text-gray-600 leading-relaxed flex-1 mt-3 overflow-y-auto" tabindex={linkTabIndex}>{bio || 'Bio coming soon.'}</p>

      <!-- Social icons -->
      {(email || instagram || linkedin || website) && (
        <div class="flex items-center gap-3 mt-3 pt-3 border-t border-gray-100">
          {email && (
            <a
              href={`mailto:${email}`}
              class="text-gray-600 hover:text-[#1B4332] transition-colors"
              aria-label={`Email ${name}`}
              tabindex={linkTabIndex}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </a>
          )}
          {instagram && (
            <a
              href={`https://instagram.com/${instagram}`}
              class="text-gray-600 hover:text-[#1B4332] transition-colors"
              aria-label={`${name} on Instagram`}
              target="_blank"
              rel="noopener noreferrer"
              tabindex={linkTabIndex}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
              </svg>
            </a>
          )}
          {linkedin && (
            <a
              href={linkedin}
              class="text-gray-600 hover:text-[#1B4332] transition-colors"
              aria-label={`${name} on LinkedIn`}
              target="_blank"
              rel="noopener noreferrer"
              tabindex={linkTabIndex}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {website && (
            <a
              href={website}
              class="text-gray-600 hover:text-[#1B4332] transition-colors"
              aria-label={`${name}'s personal website`}
              target="_blank"
              rel="noopener noreferrer"
              tabindex={linkTabIndex}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-9c2.5 2.5 3.5 6 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-6-3.5-9s1-6.5 3.5-9zM3.5 12h17"/>
              </svg>
            </a>
          )}
        </div>
      )}

      <!-- Screen-reader bio (always in DOM for SEO) -->
      <span class="sr-only">{name}, {role}.{schools ? ` ${schools}.` : ''} {bio}</span>
    </div>
  </div>
</div>

<script>
  // Flip state lives in a data-flip attribute ("back" or "front") rather than a
  // single class, because a class toggled under a hovered card fights the
  // :hover rule: half the clicks then land on the side hover is already showing
  // and appear to do nothing. Pinning the side explicitly means every click,
  // tap, and keypress visibly turns the card.
  document.querySelectorAll<HTMLElement>('[data-card-flip]').forEach((el) => {
    const hoverFlips = !el.classList.contains('card-flip-no-hover');
    // Duplicate cards for the same person (the home strip renders the roster
    // twice for a seamless loop) turn together, so the copy the visitor is
    // looking at always matches the one they clicked.
    const key = el.dataset.flipKey;
    const group = () =>
      key
        ? document.querySelectorAll<HTMLElement>(`[data-card-flip][data-flip-key="${key}"]`)
        : [el];

    const show = (side: 'front' | 'back' | null) => {
      group().forEach((card) => {
        if (side) card.dataset.flip = side;
        else delete card.dataset.flip;
        card.setAttribute('aria-pressed', String(side === 'back'));
      });
    };

    // Which pointer drove the current interaction. Blink applies :hover to a
    // tapped element, so on a touchscreen an untouched card reads as hovered the
    // instant it is tapped. Inferring the visible side from :hover then pins the
    // side already showing and the first tap does nothing at all - two taps to
    // open a bio. Only a real mouse gets to seed the state from :hover.
    let pointerKind = 'mouse';
    el.addEventListener('pointerdown', (e) => {
      pointerKind = e.pointerType || 'mouse';
    });

    const showingBack = () =>
      el.dataset.flip
        ? el.dataset.flip === 'back'
        : hoverFlips && pointerKind === 'mouse' && el.matches(':hover');

    const toggle = () => show(showingBack() ? 'front' : 'back');

    // A click on a control inside the card (the social links on the back) belongs
    // to that control, not to the flip. This replaces the per-anchor
    // onclick="event.stopPropagation()" attributes those links used to carry:
    // as a static HTML attribute there is no event in scope, so it only worked
    // by reading the deprecated window.event global. Matching on 'a, button'
    // rather than a marker attribute means any control added to a card later is
    // covered without remembering to tag it.
    el.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a, button')) return;
      toggle();
    });

    el.addEventListener('keydown', (e) => {
      // Escape closes an open card from anywhere inside it, including from a
      // focused social link, and returns focus to the card. Without this a
      // keyboard user who opens a bio has no way to dismiss it, which the
      // aria-pressed control implies they should.
      if (e.key === 'Escape' && showingBack()) {
        show('front');
        el.focus();
        return;
      }
      // Only keys typed on the card itself flip it. Enter on a focused social
      // link bubbles up here, and flipping would preventDefault() away the
      // link's own activation - the card would turn and the link never open.
      if (e.target !== el) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });

    // Hand control back to :hover once the mouse leaves, so the next hover turns
    // the card again. Touch and pen keep the pinned side - there is no hover to
    // fall back to, and clearing it would shut the bio the moment it opened.
    if (hoverFlips) {
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') show(null);
      });
    }
  });
</script>
