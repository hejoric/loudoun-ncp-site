---
import { truncate } from '@/lib/seo';

interface Props {
  title: string;
  authors: readonly string[];
  date: string;
  abstract: string;
  slug: string;
  pdfFile?: string | null;
  pdfLink?: string | null;
}

const { title, authors, date, abstract, slug, pdfFile, pdfLink } = Astro.props;
const pdfHref = pdfFile ?? pdfLink;
const displayDate = date ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : '';
// Cut on a word boundary: a raw slice left visible stubs like "localized s…".
const preview = truncate(abstract, 160);
---

<article class="panel p-7 sm:p-8 flex flex-col gap-3 transition-colors hover:border-forest-800">
  <div>
    {displayDate && <p class="kicker mb-3">{displayDate}</p>}
    {/* h3: the cards sit under the "From the field" h2 on /research/. */}
    <h3 class="text-[1.75rem] leading-[1.15]">
      <a href={`/research/${slug}/`} class="hover:text-forest-800 transition-colors">
        {title}
      </a>
    </h3>
    <p class="text-[0.9375rem] text-ink-soft mt-2">{authors.join(', ')}</p>
  </div>
  <p class="text-[0.9375rem] text-ink-soft leading-relaxed flex-1">{preview}</p>
  <div class="flex items-center gap-6 mt-auto pt-5 border-t hairline text-[0.9375rem]">
    <a href={`/research/${slug}/`} class="text-link">
      Read more<span class="sr-only"> about {title}</span>
    </a>
    {pdfHref && (
      <a
        href={pdfHref}
        class="font-medium text-ink-soft hover:text-ink transition-colors flex items-center gap-1.5"
        target="_blank"
        rel="noopener noreferrer"
        download={pdfFile ? true : undefined}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        PDF<span class="sr-only"> of {title}</span>
      </a>
    )}
  </div>
</article>
