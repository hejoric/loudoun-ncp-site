---
import type { Affiliation } from '@/lib/affiliations';

interface Props {
  affiliations: readonly Affiliation[];
}

const { affiliations } = Astro.props;

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .join('')
    .toUpperCase()
    .slice(0, 3);
}

// Every school gets a badge, falling back to its initials when there is no logo
// yet. A member affiliation without a logo used to be left to the school name
// printed under the card; that text is gone now, so skipping it here would hide
// the school outright instead of just showing it plainly.
//
// High school + college is the common case and three still fits the card;
// anything beyond that lives in the card's screen-reader summary only.
const shown = affiliations.slice(0, 3);
---

{shown.length > 0 && (
  <div class="absolute bottom-2 right-2 flex items-center gap-1.5">
    {shown.map((a) =>
      a.logo ? (
        <div
          class="w-10 h-10 rounded-full ring-2 ring-white overflow-hidden bg-white flex items-center justify-center shadow"
          title={a.name}
        >
          {/* 71% is the square that fits inside the round badge (d / sqrt(2)).
              School logos are often wordmarks whose text runs to the edge of
              the image, and letting them fill the full box clips the first and
              last letter against the circle. */}
          {/* Decorative: the card text already names the school, so the badge
              is hidden from assistive tech. alt="" rather than a description,
              because aria-hidden wins and any alt string here is dead code. */}
          <img
            src={a.logo}
            alt=""
            class="w-[71%] h-[71%] object-contain"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </div>
      ) : (
        <div
          class="w-10 h-10 rounded-full ring-2 ring-white flex items-center justify-center bg-[#1B4332] shadow"
          title={a.name}
        >
          <span class="text-white font-display font-bold text-xs">{initials(a.name)}</span>
        </div>
      )
    )}
  </div>
)}
