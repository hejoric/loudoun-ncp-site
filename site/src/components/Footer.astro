---
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-paper-2 border-t hairline text-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/assets/lncp-logo.png" alt="LNCP" width="48" height="48" class="w-12 h-12 object-contain" />
          <div>
            <p class="font-display font-semibold text-ink text-base leading-tight">Loudoun Nature<br />Conservation Project</p>
            <p class="text-xs text-clay mt-0.5">501(c)(3) Not-For-Profit</p>
          </div>
        </div>
        <p class="text-sm text-ink-soft leading-relaxed">
          Made by Students, for Students. Young hearts, green minds, hands-on action. Empowering youth, restoring nature, and fostering community through environmental stewardship in Loudoun County, Virginia.
        </p>
        <SocialLinks />
        <p class="text-xs text-ink-soft">directors@loudounnatureconservation.org</p>
      </div>

      <!-- Site map -->
      <div>
        <h3 class="font-body font-semibold text-ink text-xs uppercase tracking-widest mb-4">Site Map</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['/', 'Home'],
            ['/about/', 'About'],
            ['/volunteer/', 'Volunteer'],
            ['/research/', 'Research'],
            ['/team/', 'Team'],
            ['/events/', 'Events'],
            ['/contact/', 'Contact'],
            ['/funding/', 'Funding'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="text-ink-soft hover:text-ink transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-body font-semibold text-ink text-xs uppercase tracking-widest mb-4">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/proof-of-corporation/" class="text-ink-soft hover:text-ink transition-colors">
              Proof of Corporation
            </a>
          </li>
          <li>
            <a
              href="/research/loudoun-nature-conservation-project-docx-1-pdf/"
              class="text-ink-soft hover:text-ink transition-colors"
            >
              Bylaws
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t hairline flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-ink-soft">&copy; {new Date().getFullYear()} Loudoun Nature Conservation Project. All rights reserved.</p>
      <p class="text-xs text-ink-soft">501(c)(3) EIN available upon request</p>
    </div>
  </div>
</footer>
