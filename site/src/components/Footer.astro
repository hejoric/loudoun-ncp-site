---
import SocialLinks from './SocialLinks.astro';
import { ORG_ADDRESS_SHORT, ORG_EIN, ORG_EMAIL, ORG_NAME } from '@/lib/seo';

const year = new Date().getFullYear();
---

<footer class="bg-paper-2 border-t hairline text-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/assets/lncp-logo.png"
            alt="Loudoun Nature Conservation Project logo"
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="w-12 h-12 object-contain"
          />
          <div>
            <p class="font-display font-semibold text-ink text-base leading-tight">Loudoun Nature<br />Conservation Project</p>
            <p class="text-xs text-clay mt-0.5">501(c)(3) Not-For-Profit &middot; EIN {ORG_EIN}</p>
          </div>
        </div>
        <p class="text-sm text-ink-soft leading-relaxed">
          Made by Students, for Students. Young hearts, green minds, hands-on action. Empowering youth, restoring nature, and fostering community through environmental stewardship in Loudoun County, Virginia.
        </p>
        <SocialLinks />
        <address class="not-italic text-xs text-ink-soft leading-relaxed space-y-1">
          <p>{ORG_ADDRESS_SHORT}</p>
          <p>
            <a href={`mailto:${ORG_EMAIL}`} class="hover:text-ink transition-colors break-words">
              {ORG_EMAIL}
            </a>
          </p>
        </address>
      </div>

      <!-- Site map -->
      <div>
        <h3 class="font-body font-semibold text-ink text-xs uppercase tracking-widest mb-4">Site Map</h3>
        <ul class="space-y-2 text-sm">
          {[
            ['/', 'Home'],
            ['/about/', 'About'],
            ['/volunteer/', 'Volunteer'],
            ['/research/', 'Research'],
            ['/team/', 'Team'],
            ['/events/', 'Events'],
            ['/press/', 'Press'],
            ['/contact/', 'Contact'],
            ['/funding/', 'Funding'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="text-ink-soft hover:text-ink transition-colors">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-body font-semibold text-ink text-xs uppercase tracking-widest mb-4">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/proof-of-corporation/" class="text-ink-soft hover:text-ink transition-colors">
              Proof of Corporation
            </a>
          </li>
          <li>
            <a
              href="/research/Loudoun-Nature-Conservation-Project.docx-1.pdf"
              class="text-ink-soft hover:text-ink transition-colors"
            >
              Bylaws
            </a>
          </li>
          <li>
            <a href="/nonprofit-verification/" class="text-ink-soft hover:text-ink transition-colors">
              Nonprofit Verification
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!--
      Charitable-solicitation disclosure. Nonprofit programs (Google for
      Nonprofits among them) verify that an organization owns its domain by
      looking for the registered name and Charity ID on the site itself, so this
      block states both outright rather than offering them "upon request".
      The street line is deliberately not here - it is the founder's home, and
      lives one click away on the noindex /nonprofit-verification/ page.
    -->
    <div class="mt-10 pt-6 border-t hairline space-y-4">
      <p class="text-xs text-ink-soft leading-relaxed max-w-4xl">
        {ORG_NAME} is a nonprofit, tax-exempt charitable organization (Charity ID / EIN{' '}
        <span class="text-ink font-medium">{ORG_EIN}</span>) under Section 501(c)(3) of the U.S.
        Internal Revenue Code, incorporated in the Commonwealth of Virginia on April 26, 2024.
        Donations are tax-deductible as allowed by law. Registered office: {ORG_ADDRESS_SHORT}.
        See our{' '}
        <a href="/nonprofit-verification/" class="underline underline-offset-2 hover:text-ink transition-colors">
          full street address and registration details
        </a>.
      </p>
      <p class="text-xs text-ink-soft">&copy; {year} {ORG_NAME}. All rights reserved.</p>
    </div>
  </div>
</footer>
