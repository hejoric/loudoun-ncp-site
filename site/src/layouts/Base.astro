---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import { getSocialLinks } from '@/lib/social';
// Self-hosted type: the Instrument pair, woff2 with font-display: swap. Only
// the regular serif is preloaded - it sets every hero and section title, so a
// late swap there is the one visitors would see.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import '@/styles/global.css';
import {
  SITE_URL,
  ORG_NAME,
  buildGraph,
  organizationNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  truncate,
} from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Pixel size of `ogImage`. Declaring it lets a social crawler lay out the
   *  share card on the first share instead of fetching the image first. */
  ogImageSize?: { width: number; height: number };
  /** Alt text for the social preview image. */
  ogImageAlt?: string;
  canonicalUrl?: string;
  /** Page-specific schema.org nodes, merged into the site-wide @graph. */
  jsonLd?: object | object[];
  /** 'article' switches Open Graph to article + emits article:* meta. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  /** Suffix after the page title. Defaults to the full org name. */
  titleSuffix?: string;
  /** Keep this page out of the index (404, thin utility pages). */
  noindex?: boolean;
  /** Also tell crawlers not to follow this page's links. Only read when `noindex` is set. */
  nofollow?: boolean;
  /** Preloaded as the LCP candidate. */
  preloadImage?: string;
  breadcrumb?: Array<[name: string, path: string]>;
}

const {
  title,
  description = 'Loudoun Nature Conservation Project - A student-led 501(c)(3) nonprofit advancing sustainability and ecological health across Loudoun County, Virginia.',
  ogImage,
  ogImageSize,
  ogImageAlt = `${ORG_NAME} volunteers restoring a Loudoun County stream`,
  canonicalUrl,
  jsonLd,
  ogType = 'website',
  publishedTime,
  titleSuffix = ORG_NAME,
  noindex = false,
  nofollow = false,
  preloadImage,
  breadcrumb,
} = Astro.props;

const canonical = canonicalUrl ?? `${SITE_URL}${Astro.url.pathname}`;

// public/assets/og-default.jpg is 1200x630, the size every major network
// renders a large card at.
const shareImage = ogImage ?? '/assets/og-default.jpg';
const shareImageSize = ogImage ? ogImageSize : { width: 1200, height: 630 };

// Excluded pages still keep `follow` by default, so link equity from a thin
// utility page reaches the real pages it points at. `nofollow` is opt-in, for
// the pages that exist only to be read by one named party.
const robots = noindex
  ? `noindex, ${nofollow ? 'nofollow' : 'follow'}`
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Keep <title> inside the ~65 chars Google renders. The budget is computed
// against the suffix so the *combined* string fits, rather than truncating the
// title and then blowing the limit by appending. Research article titles run
// past 150 chars, so they get shortened here; the full title still renders as
// the visible <h1>.
const TITLE_MAX = 65;
const titleBudget = TITLE_MAX - (titleSuffix.length + 3);
const fullTitle =
  title === 'Home' ? ORG_NAME : `${truncate(title, titleBudget)} | ${titleSuffix}`;

const metaDescription = truncate(description, 160);

const isArticle = ogType === 'article';

const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Same source the footer and contact page link from, so the profiles the site
// shows and the profiles it claims in `sameAs` cannot drift apart.
const socialUrls = (await getSocialLinks()).map((link) => link.href);

const graph = buildGraph([
  organizationNode({ sameAs: socialUrls }),
  websiteNode(),
  webPageNode({
    canonical,
    title: fullTitle,
    description: metaDescription,
    isArticle,
    datePublished: publishedTime,
    primaryImage: shareImage,
    breadcrumbId: breadcrumb ? `${canonical}#breadcrumb` : undefined,
  }),
  ...(breadcrumb ? [breadcrumbNode(canonical, breadcrumb)] : []),
  ...pageNodes,
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <link rel="preload" as="font" type="font/woff2" href={serifFont} crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={`${SITE_URL}${shareImage}`} />
    {shareImageSize && <meta property="og:image:width" content={String(shareImageSize.width)} />}
    {shareImageSize && <meta property="og:image:height" content={String(shareImageSize.height)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={ORG_NAME} />
    <meta property="og:locale" content="en_US" />
    {isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={`${SITE_URL}${shareImage}`} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon. Every file here, and public/assets/lncp-logo.png itself, is
         generated from the master src/assets/brand/lncp-logo.png by
         `npm run icons` (scripts/generate-icons.mjs) - replace the master and
         regenerate rather than editing one by hand, or they drift out of sync
         with the logo again. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F4EF" />

    <!--
      One linked @graph per page: NGO + WebSite + WebPage, plus any page-specific
      nodes. Entities join by @id so crawlers merge them into one entity.
    -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <Analytics />
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- First tab stop on every page, so keyboard users can jump past the
         navigation. Invisible until focused. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2.5 focus:rounded-control focus:bg-ink focus:text-paper focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>
    <Nav />
    <!-- Every page opens with a hero band (slot="hero") and sets its body on
         the paper sheet that rises over it; the footer tucks under the sheet's
         bottom edge. Keeping the sheet here rather than in each page means no
         page can end without it and leave the footer overlapping content. -->
    <main id="main" class="flex-1">
      <slot name="hero" />
      <div class="sheet">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
