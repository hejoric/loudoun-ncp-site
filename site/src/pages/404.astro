---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
---

<Base
  title="Page Not Found"
  description="This page doesn't exist or has moved. Browse our conservation work, student research, and volunteer opportunities in Loudoun County, Virginia."
  noindex
>
  <PageHero
    slot="hero"
    eyebrow="404"
    title="Page Not Found"
    lead="This path seems to have gone back to nature. The page you're looking for doesn't exist or may have moved."
  >
    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-6">
      <a href="/" class="btn btn-action btn-lg self-start">Go Home</a>
      <a href="/contact/" class="text-link self-start text-[0.9375rem]">Contact Us</a>
    </div>
  </PageHero>
  <div class="pb-(--section)"></div>
</Base>
