---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { ORG_EIN, ORG_EMAIL, ORG_NAME } from '@/lib/seo';

const docs = [
  {
    title: 'Certificate of Incorporation',
    description: 'Virginia State Corporation Commission certificate, issued April 26, 2024.',
    file: '/research/BE19421135-20180647-CERT.pdf',
  },
  {
    title: 'Articles of Incorporation (Miscellaneous Filing)',
    description: 'Virginia SCC miscellaneous filing accompanying the incorporation.',
    file: '/research/BE19421135-20180647-MISC.pdf',
  },
  {
    title: 'Bylaws of Loudoun Nature Conservation Project',
    description: 'Nonprofit bylaws governing the organization\'s structure and operations.',
    file: '/research/Loudoun-Nature-Conservation-Project.docx-1.pdf',
  },
  {
    title: 'United States Congressional Record Recognition',
    description: 'Extension of Remarks by Rep. Suhas Subramanyam (VA-10) recognizing LNCP.',
    file: '/assets/lncp-congressional-record.pdf',
  },
];
---

<Base
  title="Proof of Corporation"
  description="Loudoun Nature Conservation Project 501(c)(3) incorporation documents - Virginia Certificate of Incorporation and Bylaws."
  breadcrumb={[['Home', '/'], ['Proof of Corporation', '/proof-of-corporation/']]}
>
  <PageHero
    slot="hero"
    eyebrow="Legal"
    title="Proof of Corporation"
    lead="Loudoun Nature Conservation Project is a legally incorporated 501(c)(3) nonprofit organization in the Commonwealth of Virginia, effective April 26, 2024."
  >
    <p class="mt-4 text-[0.9375rem] text-ink-soft">
      Charity ID / EIN <span class="text-ink font-medium">{ORG_EIN}</span>
    </p>
  </PageHero>

  <section class="section wrap">
    <div class="max-w-4xl space-y-4">
      {docs.map((doc) => (
        <div class="panel p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-[1.625rem] leading-tight">{doc.title}</h2>
            <p class="text-ink-soft text-[0.9375rem] mt-1">{doc.description}</p>
          </div>
          <a
            href={doc.file}
            class="btn btn-outline shrink-0"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            View PDF
          </a>
        </div>
      ))}

      <p class="text-[0.8125rem] text-ink-soft pt-6 leading-relaxed">
        {ORG_NAME} is a nonprofit, tax-exempt charitable organization under Section 501(c)(3) of
        the U.S. Internal Revenue Code, Charity ID / EIN {ORG_EIN}. Full registration details,
        including the organization's physical street address, are on the{' '}
        <a href="/nonprofit-verification/" class="underline underline-offset-2 hover:text-ink transition-colors">
          nonprofit verification
        </a>{' '}
        page. Additional legal documentation is available on request at{' '}
        <a href={`mailto:${ORG_EMAIL}`} class="underline underline-offset-2 hover:text-ink transition-colors">
          {ORG_EMAIL}
        </a>.
      </p>
    </div>
  </section>
</Base>
