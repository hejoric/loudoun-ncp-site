---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/photos/cleanup-sign.jpg';
import FlipCard from '@/components/FlipCard.astro';
import BranchCard from '@/components/BranchCard.astro';
import reader from '@/lib/reader';
import { resolveAffiliations } from '@/lib/affiliations';
import { getBranches } from '@/lib/branches';
import { FOUNDER_ID, ORG_ID, SITE_URL, absoluteUrl, truncate } from '@/lib/seo';
import { resolveImage } from '@/lib/images';

const allBranches = await getBranches();
const allMembers = await reader.collections.teamMembers.all();

const bySection = {
  executive:      allMembers.filter((m) => m.entry.section === 'executive').sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99)),
  directors:      allMembers.filter((m) => m.entry.section === 'directors').sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99)),
  executiveStaff: allMembers.filter((m) => m.entry.section === 'executiveStaff').sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99)),
  branchPresidents: allMembers.filter((m) => m.entry.section === 'branchPresidents').sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99)),
  branchStaff:    allMembers.filter((m) => m.entry.section === 'branchStaff').sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99)),
};

function getBranchFor(member: (typeof allMembers)[0]) {
  if (!member.entry.branch) return null;
  return allBranches.find((b) => b.slug === member.entry.branch) ?? null;
}

const schoolsFor = (member: (typeof allMembers)[0]) => resolveAffiliations(member, allBranches);

// Awards reported on the homepage. Both were given to the founder personally,
// so they hang off his Person node rather than the organization.
const FOUNDER_AWARDS = [
  '2025 Environmental Excellence Award (Student), Loudoun County Environmental Commission',
  '2025 Youth Leader, Faith Alliance for Climate Solutions Sustainability Champions Awards',
];

/** Slug-based and stable across builds, so other pages can reference a member. */
const personId = (slug: string) => `${SITE_URL}/team/#${slug}`;

// Every other page's Organization node points `founder` at FOUNDER_ID, and only
// this page defines that Person. If the founder's slug is ever renamed, the
// reference would silently dangle sitewide, so fail the build instead.
if (!allMembers.some((m) => personId(m.slug) === FOUNDER_ID)) {
  throw new Error(
    `No team member matches FOUNDER_ID (${FOUNDER_ID}). Update FOUNDER_ID in src/lib/seo.ts to the founder's current slug, or every page will reference a Person that nothing defines.`,
  );
}

// A tentative seat is a placeholder for a role nobody has been named to yet, so
// there is no person for a Person node to describe: its `name` is a stand-in
// ("To be announced"), not anybody's name. The card still renders on the page,
// but describing the vacancy as an employee of LNCP in the structured data
// would assert a person who does not exist.
const personJsonLd = allMembers.filter((m) => !m.entry.tentative).map((m) => {
  const sameAs = [m.entry.linkedin, m.entry.instagram, m.entry.website].filter(Boolean);
  return {
    '@type': 'Person',
    '@id': personId(m.slug),
    name: m.entry.name,
    url: `${SITE_URL}/team/`,
    jobTitle: m.entry.role,
    worksFor: { '@id': ORG_ID },
    // Every school the member's card shows, from the same resolver the card
    // uses, so a member with both a high school and a college is described the
    // same way in the markup and in the graph. Members are current students, so
    // these are present affiliations rather than `alumniOf`.
    affiliation: [
      { '@id': ORG_ID },
      ...schoolsFor(m).map((a) => ({ '@type': 'EducationalOrganization', name: a.name })),
    ],
    ...(m.entry.bio ? { description: truncate(m.entry.bio, 300) } : {}),
    // The full-size crop, not a card-sized derivative: this is what a search
    // engine would show as the person's image.
    ...(m.entry.headshot ? { image: absoluteUrl(resolveImage(m.entry.headshot).src) } : {}),
    ...(m.entry.email ? { email: m.entry.email } : {}),
    ...(sameAs.length ? { sameAs } : {}),
    ...(personId(m.slug) === FOUNDER_ID ? { award: FOUNDER_AWARDS } : {}),
  };
});

// An ItemList makes the roster machine-readable as an ordered collection
// instead of a loose pile of Person nodes.
const rosterJsonLd = {
  '@type': 'ItemList',
  '@id': `${SITE_URL}/team/#roster`,
  name: 'Loudoun Nature Conservation Project team',
  numberOfItems: personJsonLd.length,
  itemListElement: personJsonLd.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@id': p['@id'] },
  })),
};
---

<Base
  title="Team"
  description="Meet the student leaders of Loudoun Nature Conservation Project - the executive team, directors, and branch presidents driving conservation across Loudoun County."
  breadcrumb={[['Home', '/'], ['Team', '/team/']]}
  jsonLd={[rosterJsonLd, ...personJsonLd]}
>
  <PageHero
    slot="hero"
    eyebrow="Who We Are"
    title="Our Team"
    lead="Hover or tap any card to learn more about a team member. All members are student volunteers dedicated to conservation."
    image={heroPhoto}
    imagePosition="50% 45%"
  />

  {/* ---- EXECUTIVE ---- */}
  {bySection.executive.length > 0 && (
    <section aria-labelledby="exec-heading" class="section wrap">
      <div>
        <header class="section-head">
          <h2 id="exec-heading" class="section-title">Executive</h2>
        </header>
        <div class="team-grid">
          {bySection.executive.map((m) => (
            <div>
              {/* The executive row is the first thing under the page header, and
                  its headshots are the page's largest paint. */}
              <FlipCard
                priority
                name={m.entry.name}
                role={m.entry.role}
                bio={m.entry.bio}
                headshot={m.entry.headshot}
                headshotPosition={m.entry.headshotPosition ?? undefined}
                headshotScale={m.entry.headshotScale ?? undefined}
                email={m.entry.email ?? undefined}
                instagram={m.entry.instagram ?? undefined}
                linkedin={m.entry.linkedin ?? undefined}
                website={m.entry.website ?? undefined}
                affiliations={schoolsFor(m)}
                cardId={m.slug}
                tentative={m.entry.tentative ?? false}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ---- DIRECTORS ---- */}
  {bySection.directors.length > 0 && (
    <section aria-labelledby="directors-heading" class="section wrap">
      <div>
        <header class="section-head">
          <h2 id="directors-heading" class="section-title">Directors</h2>
        </header>
        <div class="team-grid">
          {bySection.directors.map((m) => (
            <div>
              <FlipCard
                name={m.entry.name}
                role={m.entry.role}
                bio={m.entry.bio}
                headshot={m.entry.headshot}
                headshotPosition={m.entry.headshotPosition ?? undefined}
                headshotScale={m.entry.headshotScale ?? undefined}
                email={m.entry.email ?? undefined}
                instagram={m.entry.instagram ?? undefined}
                linkedin={m.entry.linkedin ?? undefined}
                website={m.entry.website ?? undefined}
                affiliations={schoolsFor(m)}
                cardId={m.slug}
                tentative={m.entry.tentative ?? false}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ---- EXECUTIVE STAFF ---- */}
  {bySection.executiveStaff.length > 0 && (
    <section aria-labelledby="exec-staff-heading" class="section wrap">
      <div>
        <header class="section-head">
          <h2 id="exec-staff-heading" class="section-title">Executive Staff</h2>
        </header>
        {/* One line on desktop however many staff there are: never fewer
            columns than the standard grid (so small rows keep the same card
            size), and one column per member once they outnumber it. */}
        <div
          class="team-grid team-grid-row"
          style={`--cols-lg:${Math.max(bySection.executiveStaff.length, 4)};--cols-xl:${Math.max(bySection.executiveStaff.length, 5)};`}
        >
          {bySection.executiveStaff.map((m) => (
            <div>
              <FlipCard
                name={m.entry.name}
                role={m.entry.role}
                bio={m.entry.bio}
                headshot={m.entry.headshot}
                headshotPosition={m.entry.headshotPosition ?? undefined}
                headshotScale={m.entry.headshotScale ?? undefined}
                email={m.entry.email ?? undefined}
                instagram={m.entry.instagram ?? undefined}
                linkedin={m.entry.linkedin ?? undefined}
                website={m.entry.website ?? undefined}
                affiliations={schoolsFor(m)}
                cardId={m.slug}
                tentative={m.entry.tentative ?? false}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ---- BRANCH PRESIDENTS ---- */}
  {bySection.branchPresidents.length > 0 && (
    <section id="branches" aria-labelledby="branch-presidents-heading" class="section wrap">
      <div>
        <header class="section-head">
          <h2 id="branch-presidents-heading" class="section-title">Branch Presidents</h2>
        </header>
        <p class="lead text-ink-soft mt-5 max-w-[52ch]">
          Each branch president leads LNCP operations at their school or college - organizing cleanups, recruiting members, and representing their community.
        </p>
        <div class="team-grid">
          {bySection.branchPresidents.map((m) => {
            const branch = getBranchFor(m);
            return (
              <div>
                <BranchCard
                  presidentName={m.entry.name}
                  presidentRole={m.entry.role}
                  presidentBio={m.entry.bio}
                  presidentHeadshot={m.entry.headshot}
                  presidentHeadshotPosition={m.entry.headshotPosition ?? undefined}
                  presidentHeadshotScale={m.entry.headshotScale ?? undefined}
                  presidentEmail={m.entry.email ?? undefined}
                  presidentInstagram={m.entry.instagram ?? undefined}
                  presidentLinkedin={m.entry.linkedin ?? undefined}
                  branchName={branch?.entry.name ?? m.entry.branch ?? 'Branch'}
                  affiliations={schoolsFor(m)}
                  tentative={m.entry.tentative ?? false}
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ---- BRANCH STAFF ---- */}
  {bySection.branchStaff.length > 0 && (
    <section aria-labelledby="branch-staff-heading" class="section wrap">
      <div>
        <header class="section-head">
          <h2 id="branch-staff-heading" class="section-title">Branch Staff</h2>
        </header>
        <p class="lead text-ink-soft mt-5 max-w-[52ch]">
          Branch staff serve as vice presidents, operations leads, outreach leads, and general members within their school chapters.
        </p>
        <div class="team-grid">
          {bySection.branchStaff.map((m) => (
            <div>
              <FlipCard
                name={m.entry.name}
                role={m.entry.role}
                bio={m.entry.bio}
                headshot={m.entry.headshot}
                headshotPosition={m.entry.headshotPosition ?? undefined}
                headshotScale={m.entry.headshotScale ?? undefined}
                email={m.entry.email ?? undefined}
                instagram={m.entry.instagram ?? undefined}
                linkedin={m.entry.linkedin ?? undefined}
                website={m.entry.website ?? undefined}
                affiliations={schoolsFor(m)}
                cardId={m.slug}
                tentative={m.entry.tentative ?? false}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Empty state */}
  {Object.values(bySection).every((s) => s.length === 0) && (
    <div class="section wrap text-ink-soft">
      <p class="font-display text-3xl text-ink">Team roster coming soon.</p>
      <p class="mt-2">Check back shortly or <a href="/contact/" class="text-link">contact us</a>.</p>
    </div>
  )}
</Base>

<style>
  /* Fluid roster: two cards across a phone up to five on a wide screen. The
     widths feed TEAM_CARD_SIZES in src/lib/images.ts - change them together. */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .team-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  /* A group kept to a single row from lg up; the column counts come from the
     markup (see the Executive Staff section). */
  @media (min-width: 1024px) {
    .team-grid-row {
      grid-template-columns: repeat(var(--cols-lg), minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .team-grid-row {
      grid-template-columns: repeat(var(--cols-xl), minmax(0, 1fr));
    }
  }
</style>
