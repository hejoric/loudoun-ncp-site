---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import heroPhoto from '@/assets/photos/river.jpg';
import { getPublications, publisherNode } from '@/lib/publications';
import { ORG_ID, SITE_URL, truncate } from '@/lib/seo';

const sorted = await getPublications();

// Expose the publication list as a real collection so crawlers (and LLMs) can
// enumerate every paper from this one URL instead of relying on link discovery.
const publicationListJsonLd = {
  '@type': 'ItemList',
  '@id': `${SITE_URL}/research/#publications`,
  name: 'LNCP student research publications',
  numberOfItems: sorted.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: sorted.map((pub, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/research/${pub.slug}/`,
    item: {
      '@type': 'ScholarlyArticle',
      '@id': `${SITE_URL}/research/${pub.slug}/#article`,
      headline: truncate(pub.entry.title, 110),
      name: pub.entry.title,
      url: `${SITE_URL}/research/${pub.slug}/`,
      author: pub.entry.authors.map((name) => ({ '@type': 'Person', name })),
      ...(pub.entry.date ? { datePublished: pub.entry.date } : {}),
      description: truncate(pub.entry.abstract, 300),
      publisher: publisherNode(pub.entry),
      isAccessibleForFree: true,
    },
  })),
};

const collectionJsonLd = {
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/research/#collection`,
  name: 'Research',
  about: { '@id': ORG_ID },
  mainEntity: { '@id': `${SITE_URL}/research/#publications` },
};
---

<Base
  title="Research"
  description="Student research from Loudoun Nature Conservation Project on water quality, dissolved oxygen, and nitrogen dynamics in Loudoun County streams."
  breadcrumb={[['Home', '/'], ['Research', '/research/']]}
  jsonLd={[collectionJsonLd, publicationListJsonLd]}
>
  <PageHero
    slot="hero"
    eyebrow="Science & Data"
    title="Research"
    lead="Original environmental science research conducted by LNCP's student research division, investigating water quality and ecosystem health across Loudoun County and Northern Virginia."
    image={heroPhoto}
    imagePosition="50% 100%"
  />

  <section class="section wrap" aria-labelledby="publications-heading">
    <div class="section-head">
      <h2 id="publications-heading" class="section-title">From the field</h2>
      <p class="text-[0.9375rem] text-ink-soft">{sorted.length} {sorted.length === 1 ? 'publication' : 'publications'}, free to read</p>
    </div>
    {sorted.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
        {sorted.map((pub) => (
          <PublicationCard
            title={pub.entry.title}
            authors={pub.entry.authors}
            date={pub.entry.date ?? ''}
            abstract={pub.entry.abstract}
            slug={pub.slug}
            pdfFile={pub.entry.pdfFile ?? undefined}
            pdfLink={pub.entry.pdfLink ?? undefined}
          />
        ))}
      </div>
    ) : (
      <p class="text-ink-soft py-20">Publications loading soon. Check back shortly.</p>
    )}
  </section>
</Base>
