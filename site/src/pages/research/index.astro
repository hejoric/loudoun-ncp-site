---
import Base from '@/layouts/Base.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import reader from '@/lib/reader';
import { ORG_ID, SITE_URL, truncate } from '@/lib/seo';

const pubs = await reader.collections.publications.all();
const sorted = pubs.sort((a, b) => {
  if (!a.entry.date) return 1;
  if (!b.entry.date) return -1;
  return new Date(b.entry.date).getTime() - new Date(a.entry.date).getTime();
});

// Expose the publication list as a real collection so crawlers (and LLMs) can
// enumerate every paper from this one URL instead of relying on link discovery.
const publicationListJsonLd = {
  '@type': 'ItemList',
  '@id': `${SITE_URL}/research/#publications`,
  name: 'LNCP student research publications',
  numberOfItems: sorted.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: sorted.map((pub, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/research/${pub.slug}/`,
    item: {
      '@type': 'ScholarlyArticle',
      '@id': `${SITE_URL}/research/${pub.slug}/#article`,
      headline: truncate(pub.entry.title, 110),
      name: pub.entry.title,
      url: `${SITE_URL}/research/${pub.slug}/`,
      author: pub.entry.authors.map((name) => ({ '@type': 'Person', name })),
      ...(pub.entry.date ? { datePublished: pub.entry.date } : {}),
      description: truncate(pub.entry.abstract, 300),
      publisher: { '@id': ORG_ID },
      isAccessibleForFree: true,
    },
  })),
};

const collectionJsonLd = {
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/research/#collection`,
  name: 'Research',
  about: { '@id': ORG_ID },
  mainEntity: { '@id': `${SITE_URL}/research/#publications` },
};
---

<Base
  title="Research"
  description="Student research from Loudoun Nature Conservation Project on water quality, dissolved oxygen, and nitrogen dynamics in Loudoun County streams."
  breadcrumb={[['Home', '/'], ['Research', '/research/']]}
  jsonLd={[collectionJsonLd, publicationListJsonLd]}
>
  <div class="bg-paper border-b hairline py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-display italic text-clay text-lg mb-4">Science &amp; Data</p>
      <h1 class="font-display font-medium text-4xl sm:text-5xl text-ink">Research</h1>
      <p class="mt-5 text-ink-soft max-w-2xl mx-auto">
        Original environmental science research conducted by LNCP's student research division, investigating water quality and ecosystem health across Loudoun County and Northern Virginia.
      </p>
    </div>
  </div>

  <section class="py-20 bg-paper-2">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {sorted.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {sorted.map((pub) => (
            <PublicationCard
              title={pub.entry.title}
              authors={pub.entry.authors}
              date={pub.entry.date ?? ''}
              abstract={pub.entry.abstract}
              slug={pub.slug}
              pdfFile={pub.entry.pdfFile ?? undefined}
              pdfLink={pub.entry.pdfLink ?? undefined}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-soft py-20">Publications loading soon. Check back shortly.</p>
      )}
    </div>
  </section>
</Base>
