---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { publisherNode } from '@/lib/publications';
import reader from '@/lib/reader';
import { ORG_ID, SITE_URL, absoluteUrl, truncate } from '@/lib/seo';

export async function getStaticPaths() {
  const pubs = await reader.collections.publications.all();
  return pubs.map((pub) => ({ params: { slug: pub.slug } }));
}

const { slug } = Astro.params;
const pub = await reader.collections.publications.read(slug);

if (!pub) return Astro.redirect('/research/');

// UTC: the CMS stores a bare YYYY-MM-DD, which parses as UTC midnight, so
// formatting it in local time printed the day before anywhere west of UTC.
const displayDate = pub.date
  ? new Date(pub.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';
const pdfHref = pub.pdfFile ?? pub.pdfLink;

const doiId = pub.doi?.replace(/^https?:\/\/(dx\.)?doi\.org\//, '');

const canonical = `${SITE_URL}/research/${slug}/`;

const LNCP_AFFILIATION = 'Research Division, Loudoun Nature Conservation Project';

// Authors outside LNCP carry their own affiliation; everyone else is LNCP.
const outsideAffiliations = new Map(pub.authorAffiliations.map((a) => [a.name, a.affiliation]));
for (const name of outsideAffiliations.keys()) {
  if (!pub.authors.includes(name)) {
    throw new Error(`Publication "${slug}": authorAffiliations entry "${name}" matches no name in authors.`);
  }
}
const authorAffiliations = pub.authors.map((name) => outsideAffiliations.get(name));

// Authors get stable @ids so the article's author list and the standalone
// Person nodes resolve to the same entities instead of duplicating them.
const authorRefs = pub.authors.map((name) => ({
  '@id': `${canonical}#author-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`,
}));

const personJsonLd = pub.authors.map((name, i) => ({
  '@type': 'Person',
  '@id': authorRefs[i]['@id'],
  name,
  affiliation: authorAffiliations[i] ? { '@type': 'Organization', name: authorAffiliations[i] } : { '@id': ORG_ID },
}));

const articleJsonLd = {
  '@type': 'ScholarlyArticle',
  '@id': `${canonical}#article`,
  headline: truncate(pub.title, 110),
  name: pub.title,
  // Canonical HTML page, not the PDF - the PDF is an associated encoding.
  url: canonical,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  author: authorRefs,
  ...(pub.date ? { datePublished: pub.date, dateModified: pub.date } : {}),
  description: pub.abstract,
  abstract: pub.abstract,
  publisher: publisherNode(pub),
  sourceOrganization: { '@id': ORG_ID },
  ...(pub.doi
    ? {
        sameAs: pub.doi,
        identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: doiId },
      }
    : {}),
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  learningResourceType: 'Research paper',
  ...(pdfHref
    ? {
        associatedMedia: {
          '@type': 'MediaObject',
          contentUrl: absoluteUrl(pdfHref),
          encodingFormat: 'application/pdf',
        },
      }
    : {}),
};
---

<Base
  title={pub.title}
  titleSuffix="LNCP"
  description={pub.seoDescription?.trim() || pub.abstract}
  canonicalUrl={canonical}
  ogType="article"
  publishedTime={pub.date ?? undefined}
  breadcrumb={[['Home', '/'], ['Research', '/research/'], [truncate(pub.title, 60), `/research/${slug}/`]]}
  jsonLd={[articleJsonLd, ...personJsonLd]}
>
  <PageHero slot="hero" eyebrow={displayDate || 'Research'} title={pub.title}>
    <p class="mt-6 text-ink-soft text-lg">{pub.authors.join(', ')}</p>
  </PageHero>

  <article class="section wrap" aria-label={pub.title}>
    <div class="grid lg:grid-cols-[minmax(0,1fr)_22rem] gap-12 lg:gap-20 items-start">
      <section aria-labelledby="abstract-heading">
        <h2 id="abstract-heading" class="kicker mb-5">Abstract</h2>
        <p class="text-xl sm:text-[1.375rem] leading-[1.55] max-w-[62ch]">{pub.abstract}</p>
      </section>

      <aside class="space-y-10 lg:sticky lg:top-28">
        <!-- PDF Download -->
        {pdfHref && (
          <div class="on-dark rounded-card bg-forest-900 text-paper p-7">
            <p class="font-display text-[1.75rem] leading-tight">Full Paper (PDF)</p>
            <p class="text-paper/80 text-[0.9375rem] mt-1.5">{pub.preprintServer ? `Preprint on ${pub.preprintServer}` : 'Self-published, Loudoun Nature Conservation Project'}</p>
            <a
              href={pdfHref}
              class="btn btn-light mt-6"
              target={pub.pdfLink ? '_blank' : undefined}
              rel={pub.pdfLink ? 'noopener noreferrer' : undefined}
              download={pub.pdfFile ? true : undefined}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Download PDF
            </a>
          </div>
        )}

        <!-- Authors -->
        <section aria-labelledby="authors-heading">
          <h2 id="authors-heading" class="kicker mb-4">Authors</h2>
          <ul class="border-t border-ink" role="list">
            {pub.authors.map((author, i) => (
              <li class="py-3 border-b border-ink">{author}{outsideAffiliations.size > 0 && (
                <span class="block text-[0.9375rem] text-ink-soft mt-0.5">{authorAffiliations[i] ?? LNCP_AFFILIATION}</span>
              )}</li>
            ))}
          </ul>
          {outsideAffiliations.size === 0 && (
            <p class="text-[0.9375rem] text-ink-soft mt-4">{LNCP_AFFILIATION}</p>
          )}
        </section>

        {pub.doi && (
          <section aria-labelledby="doi-heading">
            <h2 id="doi-heading" class="kicker mb-4">DOI</h2>
            <a href={pub.doi} class="text-link break-all text-[0.9375rem]" target="_blank" rel="noopener noreferrer">{pub.doi}</a>
          </section>
        )}

        <a href="/research/" class="text-link inline-block text-[0.9375rem]">
          <span aria-hidden="true">&larr;</span> All Publications
        </a>
      </aside>
    </div>
  </article>
</Base>
