---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/photos/hero-poster.jpg';
import { Image } from 'astro:assets';
import mainstreetBankLogo from '@/assets/photos/mainstreet-bank-logo.png';
import loudounYouthLogo from '@/assets/photos/loudoun-youth-logo.png';
import { responsive } from '@/lib/images';
import { ORG_ID, SITE_URL } from '@/lib/seo';

// The grants stated in the prose below, as linked entities.
// "Who funds this nonprofit" is a question both donors and LLMs ask, and a
// MonetaryGrant answers it with a named funder and amount instead of leaving
// the fact buried in a paragraph. `fundedItem` points back at the org, so each
// grant joins the same graph rather than floating free.
const grantJsonLd = [
  {
    '@type': 'MonetaryGrant',
    '@id': `${SITE_URL}/funding/#mainstreet-bank-grant`,
    name: 'MainStreet Bank Grant',
    description:
      'The first monetary support Loudoun Nature Conservation Project received, funding cleanup supplies and event operations.',
    funder: {
      '@type': 'Organization',
      name: 'MainStreet Bank',
    },
    amount: {
      '@type': 'MonetaryAmount',
      value: 3000,
      currency: 'USD',
    },
    fundedItem: { '@id': ORG_ID },
  },
  {
    '@type': 'MonetaryGrant',
    '@id': `${SITE_URL}/funding/#loudoun-youth-mini-grant`,
    name: 'Loudoun Youth Mini Grant',
    description:
      'A $300 grant received by Loudoun Nature Conservation Project in support of its student-led conservation work.',
    funder: {
      '@type': 'Organization',
      name: 'Loudoun Youth, Inc.',
    },
    amount: {
      '@type': 'MonetaryAmount',
      value: 300,
      currency: 'USD',
    },
    fundedItem: { '@id': ORG_ID },
  },
];
---

<Base
  title="Funding"
  description="Support Loudoun Nature Conservation Project - learn how we're funded and how you can support student-led environmental conservation in Loudoun County, Virginia."
  breadcrumb={[['Home', '/'], ['Funding', '/funding/']]}
  jsonLd={grantJsonLd}
>
  <PageHero slot="hero" eyebrow="Support Our Work" title="Funding" image={heroPhoto} imagePosition="50% 60%" />

  <section class="section wrap">
    <div class="max-w-4xl space-y-14">
      <div>
        <p class="eyebrow text-ink-soft mb-4">How We're Funded</p>
        <p class="text-xl leading-[1.5]">
          Loudoun Nature Conservation Project operates as a volunteer-driven 501(c)(3) nonprofit. Our operations are currently funded through community donations, grants, and partnerships with local parks and schools. As a student-led organization, we keep overhead minimal to maximize our direct environmental impact.
        </p>
      </div>

      <div>
        <p class="eyebrow text-ink-soft mb-4">Our Grants</p>
        <div class="space-y-6">
          <div class="panel p-8 sm:p-10">
            <Image
              src={mainstreetBankLogo}
              alt="MainStreet Bank"
              {...responsive(mainstreetBankLogo, [208, 416, 624], '208px')}
              class="w-52 h-auto mb-6"
            />
            <h2 class="text-[2.25rem] leading-tight mb-4">MainStreet Bank Grant</h2>
            <p class="text-ink-soft leading-relaxed">
              We are deeply grateful to MainStreet Bank for awarding Loudoun Nature Conservation Project a $3,000 grant in 2024 - the very first monetary support our organization ever received. That vote of confidence in a group of students put supplies in our hands and cleanups on the calendar, and it continues to shape everything we do. Thank you, MainStreet Bank.
            </p>
          </div>
          <div class="panel p-8 sm:p-10">
            <Image
              src={loudounYouthLogo}
              alt="Loudoun Youth, Inc."
              {...responsive(loudounYouthLogo, [208, 416, 624], '208px')}
              class="w-52 h-auto mb-6"
            />
            <h2 class="text-[2.25rem] leading-tight mb-4">Loudoun Youth Mini Grant</h2>
            <p class="text-ink-soft leading-relaxed">
              We are grateful to Loudoun Youth for awarding Loudoun Nature Conservation Project the Loudoun Youth Mini Grant, a $300 award supporting our student-led conservation work. Their backing of young people caring for the community they live in means a great deal to us. Thank you, Loudoun Youth.
            </p>
          </div>
        </div>
      </div>

      <div class="panel p-8 sm:p-10">
        <h2 class="text-[2.25rem] leading-tight mb-4">Support LNCP</h2>
        <p class="text-ink-soft leading-relaxed mb-4">
          Your support helps fund cleanup supplies, research equipment, outreach materials, and branch operations across Loudoun County. Every contribution - large or small - directly supports our mission.
        </p>
        <p class="text-ink-soft leading-relaxed mb-8">
          Donations are tax-deductible under Section 501(c)(3). For donation inquiries or grant partnerships, please contact us.
        </p>
        <a
          href="mailto:directors@loudounnatureconservation.org?subject=Donation%20%2F%20Funding%20Inquiry"
          class="btn btn-action"
        >
          Contact About Funding
        </a>
      </div>

      <div>
        <p class="eyebrow text-ink-soft mb-4">Partner With Us</p>
        <p class="text-ink-soft leading-relaxed">
          We partner with local parks, businesses, schools, and environmental organizations to expand our reach and impact. If you're interested in becoming an LNCP partner, we'd love to hear from you.
        </p>
      </div>
    </div>
  </section>
</Base>
