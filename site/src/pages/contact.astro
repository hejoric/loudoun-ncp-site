---
import Base from '@/layouts/Base.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { ORG_EMAIL, ORG_ID, SITE_URL } from '@/lib/seo';

const contactPageJsonLd = {
  '@type': 'ContactPage',
  '@id': `${SITE_URL}/contact/#contactpage`,
  name: 'Contact Loudoun Nature Conservation Project',
  about: { '@id': ORG_ID },
  mainEntity: {
    '@type': 'ContactPoint',
    '@id': `${SITE_URL}/#contactpoint`,
    email: ORG_EMAIL,
    contactType: 'General, partnerships, and press inquiries',
    areaServed: 'US-VA',
    availableLanguage: 'English',
  },
};
---

<Base
  title="Contact"
  description="Contact Loudoun Nature Conservation Project - reach out about volunteering, partnerships, press inquiries, or general questions."
  breadcrumb={[['Home', '/'], ['Contact', '/contact/']]}
  jsonLd={contactPageJsonLd}
>
  <div class="bg-paper border-b hairline py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-display italic text-clay text-lg mb-4">Get In Touch</p>
      <h1 class="font-display font-medium text-4xl sm:text-5xl text-ink">Contact Us</h1>
    </div>
  </div>

  <section class="py-20 bg-paper-2">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <!-- General contact -->
        <div class="bg-paper border hairline p-8 space-y-3">
          <h2 class="font-display font-medium text-ink text-xl">General Inquiries</h2>
          <p class="text-ink-soft text-sm leading-relaxed">
            For general questions, partnership opportunities, or to learn more about LNCP's programs.
          </p>
          <a
            href="mailto:directors@loudounnatureconservation.org"
            class="inline-flex items-start gap-2 text-[#2D6A4F] font-medium text-sm hover:text-[#1B4332] transition-colors"
          >
            <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="break-words">directors@<wbr />loudounnatureconservation.org</span>
          </a>
        </div>

        <!-- Volunteer -->
        <div class="bg-paper border hairline p-8 space-y-3">
          <h2 class="font-display font-medium text-ink text-xl">Volunteer & Join</h2>
          <p class="text-ink-soft text-sm leading-relaxed">
            Ready to get involved? Sign up to volunteer or connect with your nearest school branch.
          </p>
          <a
            href="/volunteer/"
            class="inline-flex items-center gap-2 text-[#2D6A4F] font-medium text-sm hover:text-[#1B4332] transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            Volunteer Sign-Up
          </a>
        </div>

        <!-- Press -->
        <div class="bg-paper border hairline p-8 space-y-3">
          <h2 class="font-display font-medium text-ink text-xl">Press & Media</h2>
          <p class="text-ink-soft text-sm leading-relaxed">
            For media inquiries, interviews, or press coverage requests about LNCP's work.
          </p>
          <a
            href="mailto:directors@loudounnatureconservation.org?subject=Press%20Inquiry"
            class="inline-flex items-center gap-2 text-[#2D6A4F] font-medium text-sm hover:text-[#1B4332] transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Press inquiry
          </a>
        </div>

        <!-- Social -->
        <div class="bg-paper border hairline p-8 space-y-3">
          <h2 class="font-display font-medium text-ink text-xl">Follow Us</h2>
          <p class="text-ink-soft text-sm leading-relaxed">
            Stay updated on cleanups, events, and research announcements.
          </p>
          <SocialLinks variant="labeled" class="pt-1" />
        </div>
      </div>
    </div>
  </section>
</Base>
