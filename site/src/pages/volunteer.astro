---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/photos/outdoor3people.jpg';
import reader from '@/lib/reader';

const settings = await reader.singletons.siteSettings.read();
const formUrl = settings?.volunteerFormUrl ?? null;

---

<Base
  title="Volunteer"
  description="Volunteer with Loudoun Nature Conservation Project - join student-led cleanups, restoration events, and conservation efforts across Loudoun County, Virginia."
  breadcrumb={[['Home', '/'], ['Volunteer', '/volunteer/']]}
>
  <PageHero
    slot="hero"
    eyebrow="Join the Movement"
    title="Volunteer"
    lead="Young hearts, green minds, hands-on action. Join hundreds of student volunteers already protecting Loudoun County's natural spaces."
    image={heroPhoto}
    imagePosition="50% 45%"
  />

  <!-- Form -->
  <section class="section wrap" id="sign-up" aria-labelledby="form-heading">
    <div class="max-w-4xl mx-auto">
      <p class="eyebrow text-ink-soft mb-3 md:text-center">Sign Up</p>
      <h2 id="form-heading" class="section-title mb-4 md:text-center">Sign up to volunteer</h2>
      <p class="text-ink-soft text-lg mb-10 md:text-center">Fill out the form below and we'll connect you with your nearest branch.</p>

      {formUrl ? (
        <div class="overflow-hidden panel">
          <!-- frameborder/marginwidth/marginheight are deprecated; border-0 covers it. -->
          <iframe
            src={formUrl}
            width="100%"
            height="800"
            title="LNCP Volunteer Sign-Up Form"
            loading="lazy"
            class="w-full border-0"
          >
            Loading form...
          </iframe>
        </div>
      ) : (
        <div class="panel p-10">
          <p class="font-display text-[1.75rem] mb-3">Volunteer sign-up form coming soon.</p>
          <p class="text-ink-soft">
            In the meantime, email us at{' '}
            <a href="mailto:directors@loudounnatureconservation.org" class="text-link text-ink">
              directors@loudounnatureconservation.org
            </a>
          </p>
        </div>
      )}
    </div>
  </section>
</Base>
