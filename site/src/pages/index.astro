---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import heroPosterImage from '@/assets/photos/hero-poster.jpg';
import spotlightPosterImage from '@/assets/photos/wusa-spotlight-poster.jpg';
import largeGroupCleanup from '@/assets/photos/large-group-cleanup.jpg';
import eightPeopleCleanup from '@/assets/photos/8-people-cleanup-done.jpg';
import outdoorCrew from '@/assets/photos/outdoor7peoplecrew.jpg';
import outdoorThree from '@/assets/photos/outdoor3people.jpg';
import cleanupSign from '@/assets/photos/cleanup-sign.jpg';
import riverStill from '@/assets/photos/river.jpg';
import fairPhoto from '@/assets/photos/fair.jpg';
import FlipCard from '@/components/FlipCard.astro';
import JoinSection from '@/components/JoinSection.astro';
import reader from '@/lib/reader';
import { getWhatWeDo } from '@/lib/about';
import { resolveAffiliations } from '@/lib/affiliations';
import { getBranches } from '@/lib/branches';
import { getPublications } from '@/lib/publications';
import { resolveImage, responsive } from '@/lib/images';
import { ORG_ID, truncate } from '@/lib/seo';
import { VOLUNTEER_REASONS } from '@/lib/volunteer';
import {
  getPressItems,
  buildPressStrip,
  splitFeatured,
  formatPressDate,
} from '@/lib/press';

const home = await reader.singletons.home.read();
const allBranches = await getBranches();
const allTeam = await reader.collections.teamMembers.all();
const ryan = allTeam.find((m) => m.slug === 'ryan-nisay') ?? null;
const ryanPhoto = resolveImage(ryan?.entry.headshot);

// Home showcase: a continuously scrolling strip of the people leading LNCP,
// ordered executive -> directors -> branch presidents. Each card badges every
// school the member is affiliated with - their branch school plus any college
// they have added. Members without a headshot (e.g. a tentative branch) are
// skipped so the strip never shows an empty avatar.
const inSection = (section: string) =>
  allTeam
    .filter((m) => m.entry.section === section)
    .sort((a, b) => (a.entry.sortOrder ?? 99) - (b.entry.sortOrder ?? 99));

const showcaseMembers = [
  ...inSection('executive'),
  ...inSection('directors'),
  ...inSection('branchPresidents'),
]
  .filter((m) => m.entry.headshot)
  .map((m) => {
    return {
      slug: m.slug,
      tentative: m.entry.tentative ?? false,
      name: m.entry.name,
      role: m.entry.role,
      bio: m.entry.bio,
      headshot: m.entry.headshot,
      headshotPosition: m.entry.headshotPosition ?? undefined,
      headshotScale: m.entry.headshotScale ?? undefined,
      email: m.entry.email ?? undefined,
      instagram: m.entry.instagram ?? undefined,
      linkedin: m.entry.linkedin ?? undefined,
      website: m.entry.website ?? undefined,
      affiliations: resolveAffiliations(m, allBranches),
    };
  });

// Accept any YouTube reference an editor might paste (full watch URL, youtu.be
// share link with tracking params, embed/shorts URL, or a bare ID) and reduce
// it to the 11-character video ID. Returns '' if nothing usable is found, in
// which case the spotlight falls back to a thumbnail that links to the article.
function youtubeId(raw: string | null | undefined): string {
  const s = (raw ?? '').trim();
  if (!s) return '';
  if (/^[\w-]{11}$/.test(s)) return s;
  const m =
    s.match(/(?:v=|\/embed\/|\/shorts\/|youtu\.be\/)([\w-]{11})/) ??
    s.match(/([\w-]{11})/);
  return m ? m[1] : '';
}

// A "&t=90" / "&t=90s" / "&start=90" in the pasted URL sets where playback
// begins (it does not affect the poster thumbnail). Returns 0 when absent.
function youtubeStart(raw: string | null | undefined): number {
  const m = (raw ?? '').match(/[?&](?:t|start)=(\d+)/);
  return m ? parseInt(m[1], 10) : 0;
}

// Spotlight: featured WUSA video + highlight cards. Values come from the home
// singleton with hardcoded fallbacks so the section renders even before an
// editor fills them in. A blank video ID falls back to a thumbnail that links
// out to the article.
const spotlight = {
  videoId: youtubeId(home?.spotlightVideoId),
  videoStart: youtubeStart(home?.spotlightVideoId),
  videoTitle: home?.spotlightVideoTitle || 'These local students are cleaning up parks in Northern Virginia',
  videoSource: home?.spotlightVideoSource || 'WUSA9',
  videoUrl:
    home?.spotlightVideoUrl ||
    'https://www.wusa9.com/video/tech/science/environment/these-local-students-are-cleaning-up-parks-in-northern-virginia/65-71e16312-f011-4edf-a3b5-fb93d8432e6e',
  items:
    (home?.spotlightItems?.length ? home.spotlightItems : null) ?? [
      {
        label: '2025 Award',
        title: 'Winner, Environmental Excellence Award',
        body:
          "The Loudoun County Environmental Commission named LNCP founder Ryan Nisay, a Potomac Falls High School senior, the 2025 Student winner of its Environmental Excellence Award, recognizing the project for encouraging young people to take action in environmental restoration.",
        linkText: 'Read the news release (PDF)',
        linkUrl: '/assets/lncp-environmental-excellence-award-2025.pdf',
        secondaryLinkText: '',
        secondaryLinkUrl: '',
      },
      {
        label: 'Recognition',
        title: 'Honored in the U.S. Congressional Record',
        body:
          "LNCP was honored in the U.S. Congressional Record by Representative Suhas Subramanyam of Virginia's 10th Congressional District, recognizing a student-led effort now more than 270 members strong.",
        linkText: 'Read the entry on Congress.gov',
        linkUrl:
          'https://www.congress.gov/congressional-record/volume-172/issue-115/extensions-of-remarks-section/article/E694-2',
        secondaryLinkText: 'View the record (PDF)',
        secondaryLinkUrl: '/assets/lncp-congressional-record.pdf',
      },
      {
        label: 'In the community',
        title: 'A five-hour cleanup with Keep Loudoun Beautiful',
        body:
          'On April 12, LNCP collaborated with Keep Loudoun Beautiful to host a large-scale cleanup in Leesburg, Virginia, gathering an astonishing amount of trash over five hours of work.',
        linkText: 'See the post on LinkedIn',
        linkUrl:
          'https://www.linkedin.com/posts/loudoun-nature-conservation-project_on-april-12-our-organization-was-able-to-activity-7451375612444868608-Qht7',
        secondaryLinkText: '',
        secondaryLinkUrl: '',
      },
      {
        label: '2025 Award',
        title: 'Youth Leader, FACS Sustainability Champions Award',
        body:
          'Faith Alliance for Climate Solutions (FACS) named LNCP founder Ryan Nisay its 2025 Youth Leader at the 9th annual Sustainability Champions Awards Ceremony on June 5 in Fairfax, Virginia, recognizing climate leaders across Northern Virginia and Rockingham County.',
        linkText: 'Read the FACS event recap',
        linkUrl:
          'https://faithforclimate.org/celebrating-climate-champions-in-northern-virginia-and-rockingham-county-facs-2025-sustainability-champions-awards-photos-highlights/',
        secondaryLinkText: '',
        secondaryLinkUrl: '',
      },
    ],
};
// A real still from the WUSA segment makes the best poster and is guaranteed
// to exist, unlike YouTube's maxres thumbnail which 404s for some videos.
const spotlightPoster = spotlightPosterImage;

// The hero video's poster is the page's LCP. A <video poster> takes a single
// URL (no srcset), so it ships as-is: a grainy video still is one of the few
// images WebP makes larger (117 KB against the 92 KB JPEG at the default
// quality). Importing it still earns a hashed, immutably cached URL.
const heroPoster = heroPosterImage;

const PHOTO_WIDTHS = [480, 640, 800, 1024, 1280, 1600, 2048];
// A photo in the rail: 76vw capped at 1080px, 86vw on phones.
const RAIL_SIZES = '(min-width: 1422px) 1080px, (min-width: 561px) 76vw, 86vw';
// One of three photo cards across the page column, full width below md.
const CARD_SIZES = '(min-width: 1440px) 460px, (min-width: 768px) 31vw, calc(100vw - 2.5rem)';
// The spotlight video: a little over half the page column from lg up.
const VIDEO_SIZES = '(min-width: 1440px) 720px, (min-width: 1024px) 52vw, calc(100vw - 2.5rem)';

// The field gallery, as a GCC photo rail.
const railPhotos = [
  { image: largeGroupCleanup, alt: 'A large group of LNCP student volunteers gathered after a park cleanup', caption: 'Student volunteers after a Loudoun County park cleanup' },
  { image: eightPeopleCleanup, alt: 'LNCP volunteers with collected trash bags at the end of a cleanup', caption: 'Bags collected, piece by piece' },
  { image: outdoorCrew, alt: 'An LNCP cleanup crew posing together outdoors', caption: 'Crew day in the field', position: '50% 35%' },
  { image: outdoorThree, alt: 'Three LNCP volunteers working outdoors', caption: 'Hands-on restoration' },
];

// "What we do" pillars come from the About page's list, so the two pages
// describe the same programs in the same words.
const whatWeDo = await getWhatWeDo();

// From the field: the newest study leads, the next two follow, in the same
// order as /research/.
const publications = await getPublications();
const [leadPaper, ...otherPapers] = publications;
const formatPaperDate = (date: string | null | undefined) =>
  date
    ? new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    : '';

// The university strip, GCC's school-affiliation wall: every branch marked as
// a university chapter in Keystatic, straight from the branch records.
const universities = allBranches
  .filter((b) => b.entry.university)
  .sort((a, b) => a.entry.school.localeCompare(b.entry.school))
  .map((b) => ({ slug: b.slug, school: b.entry.school, logo: resolveImage(b.entry.schoolLogo) }));

// Split the hero headline on the semicolon so it renders on two lines.
const heroHeadline = home?.heroHeadline ?? 'Youth unite for Earth; inspire change piece by piece';
const heroHeadlineParts = heroHeadline.split(';').map((p) => p.trim()).filter(Boolean);

const stats = [
  { value: home?.statsAcresCleaned?.toLocaleString() ?? '3,122', label: 'Acres Cleaned' },
  { value: home?.statsMembers?.toLocaleString() ?? '270', label: 'Members' },
  { value: home?.statsImpressions?.toLocaleString() ?? '726,022', label: 'Impressions' },
  { value: home?.statsPartners?.toLocaleString() ?? '17', label: 'Partner Parks & Schools' },
];

// No Organization node here: Base emits the canonical one (with a stable @id)
// on every page. A second, differently-worded copy would read as a rival entity.

// Press coverage as linked NewsArticle nodes. Each one is `about` the org, so a
// crawler reading the graph can see who covered LNCP and where, rather than
// finding six bare outbound links it has to guess the significance of. This is
// third-party corroboration of the claims the rest of the site makes about
// itself, which is the part an LLM can actually cite.
const pressItems = await getPressItems();

// The newest story runs as a featured block with its own photo; the rest stay a
// row of outlet wordmarks. Featuring it also lifts it out of that row, which is
// what keeps two similarly named local papers (Loudoun Times-Mirror and Loudoun
// Now) from sitting side by side as near-identical labels.
const { featured: featuredPress } = splitFeatured(pressItems);

// One wordmark per outlet, every outlet - including whichever one is featured
// above. The row is the roster of who has covered LNCP, so leaving the newest
// outlet out of it reads as though it never ran anything.
const pressStrip = buildPressStrip(pressItems);

const pressJsonLd = pressItems.map((p) => ({
  '@type': 'NewsArticle',
  '@id': p.url,
  url: p.url,
  headline: truncate(p.headline, 110),
  name: p.headline,
  about: { '@id': ORG_ID },
  publisher: { '@type': 'NewsMediaOrganization', name: p.publication },
  ...(p.date ? { datePublished: p.date } : {}),
  ...(p.byline ? { author: { '@type': 'Person', name: p.byline } } : {}),
  ...(p.summary ? { description: truncate(p.summary, 300) } : {}),
}));
---
<Base
  title="Home"
  description="A student-led 501(c)(3) nonprofit empowering youth to restore nature through cleanups, habitat restoration, and research in Loudoun County, Virginia."
  preloadImage={heroPoster.src}
  jsonLd={pressJsonLd}
>
  <!-- Hero: a landscape-only loop behind a centered serif headline. The
       sources carry data-src, not src, so nothing downloads until the script
       below attaches them once the page has loaded: the poster is the LCP, and
       a video starting at the same moment competes with it for bandwidth. AV1
       comes first for browsers that decode it; everything else takes the
       H.264. -->
  <section slot="hero" class="hero hero-home" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <video
        id="hero-video"
        class="pointer-events-none"
        autoplay
        muted
        loop
        playsinline
        poster={heroPoster.src}
        data-hero-video
      >
        <source data-src="/assets/hero-2026-av1.mp4" type='video/mp4; codecs="av01.0.05M.08"' />
        <source data-src="/assets/hero-2026.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="max-w-6xl mx-auto">
      <p class="hero-eyebrow">Loudoun County, Virginia</p>
      <h1 id="hero-title" class="hero-title">
        {heroHeadlineParts.map((part, i) => (
          <span class="block">{part}{i < heroHeadlineParts.length - 1 ? ';' : ''}</span>
        ))}
      </h1>
      <p class="hero-sub max-w-[52ch]">
        {home?.heroSubtext ?? 'Made by Students, for Students. Young hearts, green minds, hands-on action - empowering youth, restoring nature, and fostering community through non-profit (501c3) environmental stewardship in Loudoun County, Virginia.'}
      </p>
      <div class="mt-9 flex flex-col items-center gap-4">
        <a href="/volunteer/" class="btn btn-action btn-lg">Volunteer with us</a>
        <p class="text-sm font-medium text-white/95 [text-shadow:0_1px_12px_rgb(15_22_17/0.5)]">
          We're coming back, Loudoun. New school branches announced for the upcoming year.{' '}
          <a href="/team/#branches" class="border-b border-white/70 hover:border-white transition-colors whitespace-nowrap">See our branches <span aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>

    <!-- Pause control for the background video (WCAG 2.2.2). It stays hidden
         until the video actually starts playing, so visitors who only ever
         see the poster get no control for motion that is not there. -->
    <button
      type="button"
      class="icon-btn absolute bottom-16 right-(--gutter) z-20 w-11 h-11 text-white border-white/70 bg-shade/30 backdrop-blur-sm hover:bg-white hover:text-ink hover:border-white motion-reduce:hidden"
      aria-label="Pause background video"
      data-hero-video-toggle
      hidden
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="pause"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
      <svg class="w-4 h-4 translate-x-px hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="play"><path d="M8 5v14l11-7z"/></svg>
    </button>
  </section>

  <!-- Mission -->
  <section class="section wrap" aria-labelledby="mission-heading">
    <p class="eyebrow text-ink-soft">Conservation</p>
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-16 mt-5 items-start">
      <h2 id="mission-heading" class="section-title-sm">
        {home?.missionHeading ?? 'The deliberate act of preserving, protecting, and restoring our natural environment for the benefit of future generations.'}
      </h2>
      <div>
        <p class="text-lg sm:text-xl leading-normal text-ink-soft">
          {home?.missionBody ?? 'Loudoun Nature Conservation Project is a student-led nonprofit working to advance sustainability and ecological health across Loudoun County. We engage our community through education, hands-on restoration, and advocacy, empowering young people to become lifelong stewards of the environment.'}
        </p>
        <a href="/about/" class="text-link inline-block mt-7 text-[0.9375rem]">Learn more about our mission</a>
      </div>
    </div>
  </section>

  <!-- Field gallery: GCC's photo rail with arrow buttons -->
  <div class="mt-12">
    <div class="rail" tabindex="0" role="region" aria-label="Photographs of LNCP volunteers in the field" data-rail>
      {railPhotos.map(({ image, alt, caption, position }) => (
        <figure>
          <Image
            src={image}
            alt={alt}
            {...responsive(image, PHOTO_WIDTHS, RAIL_SIZES)}
            style={position ? `object-position:${position};` : undefined}
          />
          <figcaption class="photo-caption">{caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="wrap flex justify-end gap-3 pt-4">
      <button type="button" class="icon-btn" aria-label="Previous photo" data-rail-prev>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5"/></svg>
      </button>
      <button type="button" class="icon-btn" aria-label="Next photo" data-rail-next>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg>
      </button>
    </div>
  </div>

  <!-- Hand-drawn seedling, in the place GCC keeps its node motif. -->
  <div class="grid place-items-center pt-(--section) text-ink" aria-hidden="true">
    <svg class="w-[132px] h-auto" viewBox="0 0 132 120" fill="none">
      <path d="M66 116c.6-10-1.4-19 .4-29 1.6-9.2-.8-17 .6-26 1-6.4-.4-12 .2-18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M66.4 62c-6-12-19-17.6-31-16.4-6.8.8-12 3-15.4 6.4 5 9.6 13.4 16.8 24.6 18.4 9.2 1.4 16.4-2.2 21.8-8.4Z" fill="var(--color-ember)"/>
      <path d="M67 46c4.4-12.8 16.8-21 29.6-21.4 7-.2 12.6 1.4 16.4 4.2-3.6 10.4-11.2 18.4-22.4 21.4-9.2 2.4-16.8-.2-23.6-4.2Z" fill="var(--color-ember)"/>
      <path d="M66.6 26c-3.6-7.4-3-15.6 1.6-22 3.8 2.6 6.4 7.8 6.6 13.2.2 5.4-3.2 8.6-8.2 8.8Z" fill="var(--color-ember)"/>
      <path d="M24 55c10 2.2 24 5.4 42 7M110 29c-12 5.6-27 12-43 17" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity=".55"/>
      <path d="M46 116c14-3 26-3 40 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- What we do: numbered pillars, then the numerals -->
  <section class="section wrap rise pt-[clamp(40px,5vw,64px)]" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading" class="section-title">What we do</h2>
      <a href="/about/#what-we-do" class="text-link text-[0.9375rem]">Our work</a>
    </div>
    <ol class="grid md:grid-cols-2 gap-x-16 gap-y-10 md:gap-y-14 mt-12 md:mt-16" role="list">
      {whatWeDo.map((item, i) => (
        <li>
          <span class="text-[0.8125rem] tracking-[0.04em] text-ink-soft tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-[clamp(1.75rem,2.4vw,2.25rem)] leading-[1.1]">{item.heading}</h3>
          <p class="mt-3 max-w-[46ch] text-ink-soft">{item.body}</p>
        </li>
      ))}
    </ol>

    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 mt-(--section)" aria-label="Impact statistics">
      {stats.map(({ value, label }) => (
        <div>
          <dt class="sr-only">{label}</dt>
          <dd class="stat-value">{value}</dd>
          <dd class="mt-4 text-[1.0625rem]">{label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- From the field: the research band -->
  {leadPaper && (
    <section class="section wrap rise" id="research" aria-labelledby="research-heading">
      <div class="on-dark relative isolate overflow-hidden rounded-sheet bg-forest-900 text-paper p-[clamp(28px,5vw,72px)] max-sm:px-5">
        <svg class="absolute -right-36 -top-28 w-[820px] h-auto -z-10 opacity-15 text-paper" viewBox="0 0 900 700" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M470 350c0-40 38-62 78-58 44 4 70 36 64 74-6 40-46 58-84 52-36-6-58-30-58-68Z"/>
          <path d="M420 352c-4-72 60-116 132-110 76 6 118 62 108 128-10 70-80 104-146 94-62-10-90-50-94-112Z"/>
          <path d="M370 356c-8-104 82-172 186-160 104 12 162 92 148 184-14 96-108 146-202 134-84-12-126-66-132-158Z"/>
          <path d="M318 360c-10-140 104-230 244-212 136 16 208 124 188 244-20 124-138 192-262 172-110-18-162-88-170-204Z"/>
          <path d="M264 366c-12-176 128-290 302-266 170 22 256 156 230 306-26 152-170 238-322 212-132-24-198-110-210-252Z"/>
          <path d="M208 372c-14-212 152-348 360-320 204 28 304 188 272 366-30 180-202 282-382 250-156-28-236-130-250-296Z"/>
        </svg>
        <div class="section-head">
          <div>
            <p class="eyebrow text-forest-100 mb-3.5">From the field</p>
            <h2 id="research-heading" class="section-title">Student research</h2>
          </div>
          <a href="/research/" class="text-link text-[0.9375rem] hover:text-forest-100">All studies</a>
        </div>
        <ul class="grid md:grid-cols-2 gap-4 mt-11" role="list">
          <li class="md:col-span-2 grid md:grid-cols-2 gap-x-12 gap-y-4 rounded-card bg-forest-950 p-7 max-sm:p-5.5">
            <div>
              {leadPaper.entry.date && (
                <p class="text-[0.8125rem] font-medium tracking-[0.04em] text-forest-100"><time datetime={leadPaper.entry.date}>{formatPaperDate(leadPaper.entry.date)}</time></p>
              )}
              <h3 class="mt-3.5 text-[clamp(1.875rem,2.8vw,2.625rem)] leading-[1.15]">
                <a href={`/research/${leadPaper.slug}/`} class="hover:text-forest-100 transition-colors">{leadPaper.entry.title}</a>
              </h3>
              <p class="mt-3 text-[0.9375rem] text-paper/85">{leadPaper.entry.authors.join(', ')}</p>
            </div>
            <div class="flex flex-col gap-4">
              <p class="text-paper/85">{truncate(leadPaper.entry.abstract, 320)}</p>
              <div class="mt-auto pt-2">
                <a href={`/research/${leadPaper.slug}/`} class="btn btn-light btn-sm">Read the study<span class="sr-only">: {leadPaper.entry.title}</span></a>
              </div>
            </div>
          </li>
          {otherPapers.slice(0, 2).map((paper) => (
            <li class="flex flex-col gap-3 rounded-card border border-paper/20 p-7 max-sm:p-5.5">
              {paper.entry.date && (
                <p class="text-[0.8125rem] font-medium tracking-[0.04em] text-forest-100"><time datetime={paper.entry.date}>{formatPaperDate(paper.entry.date)}</time></p>
              )}
              <h3 class="text-[1.6875rem] leading-[1.15]">
                <a href={`/research/${paper.slug}/`} class="hover:text-forest-100 transition-colors">{paper.entry.title}</a>
              </h3>
              <p class="text-[0.9375rem] text-paper/85">{paper.entry.authors.join(', ')}</p>
              <div class="mt-auto pt-2">
                <a href={`/research/${paper.slug}/`} class="btn btn-light btn-sm">Read the study<span class="sr-only">: {paper.entry.title}</span></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Get involved: GCC's tall photo cards with overlaid copy -->
  <section class="section wrap rise" aria-labelledby="involved-heading">
    <div class="section-head">
      <h2 id="involved-heading" class="section-title">Get involved</h2>
      <a href="/events/" class="text-link text-[0.9375rem]">All events</a>
    </div>
    <ul class="grid md:grid-cols-3 gap-4 mt-12" role="list">
      {[
        {
          image: cleanupSign,
          position: '50% 50%',
          title: 'Volunteer',
          body: VOLUNTEER_REASONS[1].body,
          href: '/volunteer/',
          cta: 'Sign up to volunteer',
        },
        {
          image: riverStill,
          position: '30% 50%',
          title: 'Read the research',
          body: "Original environmental science from LNCP's student research division, on water quality and ecosystem health across Loudoun County.",
