  <JoinSection />

  <!-- Phones: the one action follows the reader once the hero's own button has
       scrolled away, and steps aside again from the join section down so it
       never covers the real button or the footer. -->
  <a href="/volunteer/" class="btn btn-action btn-lg fixed left-1/2 bottom-4 z-40 -translate-x-1/2 translate-y-[140%] transition-transform duration-300 shadow-[0_12px_30px_rgb(15_22_17/0.35)] lg:hidden data-on:translate-y-0" data-dock inert>
    Volunteer with us
  </a>
</Base>

<script>
  // Hero video: attach the sources after the load event (see the markup
  // comment). Visitors who asked for reduced motion, and visitors with
  // Save-Data on, never get sources attached: they see the poster still, and
  // neither pays for the download.
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (heroVideo && !saveData && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const attach = () => {
      heroVideo.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        source.src = source.dataset.src!;
      });
      heroVideo.load();
    };
    if (document.readyState === 'complete') attach();
    else window.addEventListener('load', attach, { once: true });

    const toggle = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
    if (toggle) {
      const pauseIcon = toggle.querySelector<SVGElement>('[data-icon="pause"]')!;
      const playIcon = toggle.querySelector<SVGElement>('[data-icon="play"]')!;
      const sync = () => {
        const paused = heroVideo.paused;
        toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
        pauseIcon.classList.toggle('hidden', paused);
        playIcon.classList.toggle('hidden', !paused);
      };
      heroVideo.addEventListener('play', () => {
        toggle.hidden = false;
        sync();
      });
      heroVideo.addEventListener('pause', sync);
      toggle.addEventListener('click', () => {
        if (heroVideo.paused) heroVideo.play().catch(() => {});
        else heroVideo.pause();
      });
    }
  }

  // Spotlight video: lazy YouTube facade. We render a thumbnail + play button
  // and only inject the heavy iframe once the visitor chooses to play, keeping
  // the initial page fast and avoiding YouTube cookies until intent is clear.
  const facade = document.querySelector<HTMLElement>('[data-yt-facade]');
  if (facade) {
    const play = () => {
      const id = facade.dataset.ytId;
      if (!id) return;
      const title = facade.dataset.ytTitle ?? 'Video';
      const iframe = document.createElement('iframe');
      iframe.className = 'absolute inset-0 w-full h-full';
      const start = facade.dataset.ytStart ? `&start=${facade.dataset.ytStart}` : '';
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start}`;
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      facade.replaceChildren(iframe);
      facade.classList.remove('cursor-pointer', 'group');
      iframe.focus();
    };
    facade.addEventListener('click', play);
    facade.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        play();
      }
    });
  }

  // Photo rail arrows: one photo (its width plus the gap) per press.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const step = () => (rail.querySelector('figure')?.getBoundingClientRect().width ?? 0) + 16;
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    document.querySelector('[data-rail-prev]')?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: smooth }));
    document.querySelector('[data-rail-next]')?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: smooth }));
  }

  // Phone dock: shown once the hero is out of view, hidden again from the join
  // section down. While hidden it is inert, so it is never an invisible tab
  // stop or a stray link for a screen reader.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const hero = document.querySelector<HTMLElement>('.hero-home');
  const join = document.getElementById('join');
  if (dock && hero && join) {
    let heroGone = false;
    let pastJoin = false;
    const sync = () => {
      const on = heroGone && !pastJoin;
      dock.toggleAttribute('data-on', on);
      dock.inert = !on;
    };
    new IntersectionObserver(([entry]) => {
      heroGone = !entry.isIntersecting;
      sync();
    }).observe(hero);
    new IntersectionObserver(([entry]) => {
      pastJoin = entry.isIntersecting || entry.boundingClientRect.top < 0;
      sync();
    }).observe(join);
  }

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Team showcase marquee: a slow, ambient auto-scroll that any visitor can
  // take over. The viewport is a real horizontal scroller, so the arrow buttons
  // (jump ~3 members), trackpad/touch swiping, and the auto-drift all move the
  // same scrollLeft. Two identical copies of the roster sit end to end; whenever
  // scrollLeft passes one copy width we subtract it, which is invisible because
  // the copies are identical. Auto-scroll pauses while a card is hovered/focused
  // (to read or flip it) and for a beat after any manual interaction. Under
  // prefers-reduced-motion the drift never starts, but the arrows and swiping do.
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  const viewport = marquee?.querySelector<HTMLElement>('[data-marquee-viewport]');
  const track = marquee?.querySelector<HTMLElement>('[data-marquee-track]');

  if (marquee && viewport && track) {
    const copyWidth = () => track.scrollWidth / 2;

    const wrap = () => {
      const w = copyWidth();
      if (w <= 0) return;
      if (viewport.scrollLeft >= w) viewport.scrollLeft -= w;
      else if (viewport.scrollLeft < 0) viewport.scrollLeft += w;
    };

    // Whenever a scroll (arrow jump, wheel, touch swipe) settles past the end of
    // the first copy of the roster, subtract a copy width to bring it back.
    // Invisible, since the copies are identical and flip in lockstep.
    if ('onscrollend' in window) {
      viewport.addEventListener('scrollend', wrap);
    } else {
      let wrapTimer: ReturnType<typeof setTimeout> | undefined;
      viewport.addEventListener(
        'scroll',
        () => {
          clearTimeout(wrapTimer);
          wrapTimer = setTimeout(wrap, 150);
        },
        { passive: true }
      );
    }

    // Tracked separately (rather than one shared `hovering` flag) because a
    // click can leave keyboard focus on a nav button after the pointer moves
    // away, or vice versa; combining them with OR means a mismatched pair can
    // never wedge auto-scroll paused forever.
    let pointerOver = false;
    let focusWithin = false;
    const isHovering = () => pointerOver || focusWithin;
    let resumeAt = 0;
    const holdFor = (ms: number) => {
      resumeAt = Math.max(resumeAt, performance.now() + ms);
    };

    marquee.addEventListener('pointerenter', () => (pointerOver = true));
    marquee.addEventListener('pointerleave', (e) => {
      pointerOver = false;
      // A mouse user who has wandered off is done reading: turn any card they
      // opened back to its portrait so the drifting strip returns to its calm
      // default. Touch taps are left alone - there is no "moving away" there.
      if (e.pointerType !== 'mouse') return;
      track.querySelectorAll<HTMLElement>('[data-card-flip][data-flip]').forEach((card) => {
        card.dispatchEvent(new Event('card-flip:reset'));
      });
    });
    // Scoped to the card track, not the whole marquee: clicking a nav button
    // leaves it focused indefinitely (browsers don't auto-blur it), and if
    // that counted here it would pause auto-scroll forever after a single
    // arrow click. Focus on an actual card still pauses, so keyboard users
    // get time to read/flip it; the buttons rely on holdFor()'s short grace
    // window instead.
    track.addEventListener('focusin', () => (focusWithin = true));
    track.addEventListener('focusout', () => (focusWithin = false));
    viewport.addEventListener('wheel', () => holdFor(2500), { passive: true });
    viewport.addEventListener('touchstart', () => holdFor(4000), { passive: true });
    viewport.addEventListener('touchmove', () => holdFor(4000), { passive: true });

    // Drift is accumulated in a float `pos`, not by reading scrollLeft back each
    // frame: at devicePixelRatio 1 scrollLeft rounds to whole pixels, so a
    // sub-pixel increment would round to 0 and never move. We re-sync `pos` from
    // the real scrollLeft whenever drift resumes, so button jumps and swipes are
    // never fought or undone.
    const SPEED = 0.4; // px per frame - a slow, unobtrusive drift
    let pos = viewport.scrollLeft;
    let active = false;
    // The loop only runs while the strip is on screen. Otherwise it would
    // write scrollLeft 60 times a second for the whole visit, including the
    // long stretch spent reading everything above and below it.
    let onScreen = false;
    let frame = 0;
    const drift = () => {
      if (!onScreen) {
        frame = 0;
        active = false;
        return;
      }
      const canMove = !reduced && !isHovering() && performance.now() >= resumeAt;
      if (canMove) {
        if (!active) {
          pos = viewport.scrollLeft;
          active = true;
        }
        const w = copyWidth();
        pos += SPEED;
        if (w > 0) {
          if (pos >= w) pos -= w;
          else if (pos < 0) pos += w;
        }
        viewport.scrollLeft = pos;
      } else {
        active = false;
      }
      frame = requestAnimationFrame(drift);
    };
    // Wait one frame so the track has laid out and copyWidth() is measurable.
    requestAnimationFrame(() => {
      wrap();
      new IntersectionObserver(([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen && !frame) frame = requestAnimationFrame(drift);
      }).observe(viewport);
    });

    // How far one button press travels: three members (card width + its gap).
    const stepDistance = () => {
      const item = track.querySelector<HTMLElement>('.marquee-item');
      if (!item) return 720;
      const gap = parseFloat(getComputedStyle(item).marginRight) || 0;
      return (item.getBoundingClientRect().width + gap) * 3;
    };

    const jump = (dir: number) => {
      const w = copyWidth();
      let sl = ((viewport.scrollLeft % w) + w) % w; // normalise into [0, w)
      const amount = stepDistance();
      // Give a leftward jump room to travel without crossing the seam mid-scroll.
      if (dir < 0 && sl < amount) sl += w;
      viewport.scrollLeft = sl; // instant + invisible (identical copy)
      viewport.scrollBy({ left: dir * amount, behavior: reduced ? 'auto' : 'smooth' });
      holdFor(2500);
    };

    marquee
      .querySelector<HTMLElement>('[data-marquee-prev]')
      ?.addEventListener('click', () => jump(-1));
    marquee
      .querySelector<HTMLElement>('[data-marquee-next]')
      ?.addEventListener('click', () => jump(1));
  }
</script>
