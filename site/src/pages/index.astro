  <!-- Featured Team: a slow, continuously scrolling showcase -->
  {showcaseMembers.length > 0 && (
    <section class="section overflow-hidden rise" aria-labelledby="team-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="team-heading" class="section-title">The students leading LNCP</h2>
          <a href="/team/" class="text-link text-[0.9375rem]">View the full team</a>
