---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import PageHero from '@/components/PageHero.astro';
import JoinSection from '@/components/JoinSection.astro';
import heroPhoto from '@/assets/photos/large-group-cleanup.jpg';
import missionPhoto from '@/assets/photos/8-people-cleanup-done.jpg';
import reader from '@/lib/reader';
import { getWhatWeDo } from '@/lib/about';
import { responsive } from '@/lib/images';
import { ORG_ID, SITE_URL } from '@/lib/seo';
import { getPressItems, formatPressDate } from '@/lib/press';

const about = await reader.singletons.about.read();

const whatWeDo = await getWhatWeDo();

// Same normalized source as the homepage strip and /press/, so the three can't
// drift apart. /press/ is the full index; this is the in-page summary.
const pressLinks = await getPressItems();

const impactStats = about?.impactStats?.length
  ? about.impactStats
  : [
      { value: '3,122', label: 'Acres Cleaned' },
      { value: '310', label: 'Members' },
      { value: '900,000+', label: 'Impressions' },
      { value: '10', label: 'Branches' },
    ];

const aboutPageJsonLd = {
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/about/#aboutpage`,
  name: 'About Loudoun Nature Conservation Project',
  mainEntity: { '@id': ORG_ID },
};
---

<Base
  title="About"
  description={about?.metaDescription ??
    'Our mission, values, programs, and impact as a student-led 501(c)(3) environmental nonprofit in Loudoun County, Virginia.'}
  breadcrumb={[['Home', '/'], ['About', '/about/']]}
  jsonLd={aboutPageJsonLd}
>
  <PageHero slot="hero" eyebrow="Who We Are" title="About LNCP" image={heroPhoto} imagePosition="50% 42%" />

  <!-- Mission -->
  <section class="section wrap" aria-labelledby="mission-heading">
    <div class="section-head">
      <h2 id="mission-heading" class="section-title">Made by students, for students.</h2>
      <a href="/team/" class="text-link text-[0.9375rem]">Meet the team</a>
    </div>
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-16 mt-10 items-start">
      <p class="text-xl sm:text-[1.375rem] leading-[1.5]">
        {about?.mission ?? 'Loudoun Nature Conservation Project is a student-led nonprofit working to advance sustainability and ecological health across Loudoun County. We engage our community through education, hands-on restoration, and advocacy, empowering young people to become lifelong stewards of the environment. Through local cleanups, habitat restoration, and outreach events, we work to restore ecosystems and build a lasting culture of environmental responsibility. Made by students, for students, we\'re proving that the next generation of conservation leaders is already at work.'}
      </p>
      <figure class="m-0">
        <Image
          src={missionPhoto}
          alt="LNCP volunteers with collected trash bags at the end of a cleanup"
          {...responsive(missionPhoto, [480, 640, 800, 1024, 1280], '(min-width: 1440px) 640px, (min-width: 1024px) 45vw, calc(100vw - 2.5rem)')}
          class="w-full aspect-[4/3] object-cover rounded-card"
        />
        <figcaption class="text-[0.8125rem] text-ink-soft mt-3">Bags collected, piece by piece</figcaption>
      </figure>
    </div>

    <!-- Impact -->
    <dl class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-[clamp(1.5rem,6vw,6rem)] gap-y-12 mt-(--section)" aria-label="Our impact">
      {impactStats.map(({ value, label }) => (
        <div>
          <dt class="sr-only">{label}</dt>
          <dd class="stat-value stat-value-sm">{value}</dd>
          <dd class="mt-4 text-[1.0625rem]">{label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- What We Do: numbered programs on the brand green -->
  <section class="section wrap rise" id="what-we-do" aria-labelledby="what-we-do-heading">
    <div class="on-dark rounded-sheet bg-forest-900 text-paper p-[clamp(28px,5vw,72px)] max-sm:px-5">
      <p class="eyebrow text-forest-100 mb-3.5">How we serve Loudoun County</p>
      <h2 id="what-we-do-heading" class="section-title">What we do</h2>
      <ol class="grid lg:grid-cols-3 gap-x-12 gap-y-10 mt-12" role="list">
        {whatWeDo.map((item, i) => (
          <li class="border-t border-paper/20 pt-6">
            <span class="text-[0.8125rem] tracking-[0.04em] text-forest-100 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-[clamp(1.75rem,2.4vw,2.25rem)] leading-[1.1]">{item.heading}</h3>
            <p class="mt-3 max-w-[48ch] text-paper/85">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Values: GCC's ruled list, the value on the left and what it means on the right -->
  {about?.values?.length ? (
    <section class="section wrap rise" id="values" aria-labelledby="values-heading">
      <p class="eyebrow text-ink-soft mb-3">Our Values</p>
      <h2 id="values-heading" class="section-title">What guides our work</h2>
      <dl class="mt-10 border-t border-ink">
        {about.values.map((item) => (
          <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] gap-x-16 gap-y-2 py-7 border-b border-ink">
            <dt class="font-display text-[clamp(1.75rem,2.6vw,2.5rem)] leading-[1.05]">{item.heading}</dt>
            <dd class="text-ink-soft text-lg leading-relaxed max-w-[56ch]">{item.body}</dd>
          </div>
        ))}
      </dl>
    </section>
  ) : null}

  <!-- Press -->
  <section class="section wrap rise" aria-labelledby="press-heading">
    <div class="section-head">
      <h2 id="press-heading" class="section-title">In the news</h2>
      <a href="/press/" class="text-link text-[0.9375rem]">See the full press page</a>
    </div>
    {pressLinks.length > 0 ? (
      <ul class="mt-10 border-t border-ink" role="list">
        {pressLinks.map((link) => (
          <li class="border-b border-ink">
            <a
              href={link.url}
              class="group grid sm:grid-cols-[14rem_minmax(0,1fr)_auto] items-baseline gap-x-8 gap-y-1 py-6"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="text-[0.9375rem] font-medium">
                {link.publication}
                {formatPressDate(link.date) && (
                  <span class="block text-[0.8125rem] font-normal text-ink-soft mt-0.5">
                    <time datetime={link.date}>{formatPressDate(link.date)}</time>
                  </span>
                )}
              </span>
              <span class="font-display text-[1.5rem] sm:text-[1.75rem] leading-[1.15] group-hover:text-forest-800 transition-colors">{link.headline}</span>
              <span class="hidden sm:block text-ink-soft group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-ink-soft">Contact us for press inquiries.</p>
    )}
  </section>

  <JoinSection />
</Base>
